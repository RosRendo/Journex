// ============================================================
// AdaptiveICT Decision Engine | Pine Script v5
// Version: 2.10 (Volume Profile POC & Institutional Confluence)
// ============================================================
// A professional-grade market intelligence dashboard.
// NOT a simple signal indicator — it explains WHY a trade exists.
//
// Changelog v2.10 (2026-09-28):
//   - US1: Developing Daily Volume Profile (20 dynamic bins, POC, 70% VAH/VAL)
//   - US1: Virgin POC (vPOC) Forward Projection & Touch Termination (max 3)
//   - US1: Market Profile 80% Rule Rotation state machine & alerts
//   - US2: Asian Session Range (00:00–08:00 UTC) High/Low reference mapping
//   - US2: London Judas Swing Liquidity Sweep detector & visual markers
//   - US2: New York Midnight Open (00:00 EST / 04:00 UTC) True Day Open benchmark
//   - US3: Cumulative Volume Delta (CVD) calculation & delta absorption at POC
//   - US4: Multi-Asset SMT Divergence Radar (XAUUSD vs XAGUSD / EURUSD vs DXY)
//   - Confluence Scorecard: +10 Institutional bonus points integration
//   - Drawing object lifecycle GC ensuring < 100 active lines & labels
// ============================================================
// A professional-grade market intelligence dashboard.
// NOT a simple signal indicator — it explains WHY a trade exists.
//
// Modules:
//   1. Momentum Engine       (Velocity, Acceleration, Expansion, Volume)
//   2. Market Regime         (ADX, ATR, EMA slope, structure)
//   3. Volatility Engine     (ATR %, candle range, expansion)
//   4. ICT Smart Money       (Structure, Liquidity, FVG, OB, Premium/Discount)
//   5. Decision Scorer       (Weighted multi-factor confluence 0-100)
//   6. Trade Visualizer      (Entry / SL / TP lines + labels)
//   7. Dashboard Panel       (Large HUD table overlay)
// ============================================================
//@version=5
indicator("AdaptiveICT Decision Engine", shorttitle="AICT-DE", overlay=true, max_lines_count=200, max_labels_count=200, max_boxes_count=100)

// ============================================================
// ── INPUTS
// ============================================================
var string G_MODE  = "Mode & Strategy"
var string G_MOM   = "Momentum Engine"
var string G_REG   = "Regime & Volatility"
var string G_ICT   = "ICT Smart Money"
var string G_MTF   = "Multi-Timeframe Engine"
var string G_SESS  = "Session Filter Engine"
var string G_OFLOW = "Order Flow Engine"
var string G_NEWS  = "News / Calendar Filter"
var string G_EXEC  = "Execution & Trade"
var string G_DISP  = "Display Settings"

mode       = input.string("MQL5 Engine Parity (v0.50)", "Trading Mode", options=["MQL5 Engine Parity (v0.50)", "Momentum Scalper", "ICT Swing / Sniper"], group=G_MODE)
min_score  = input.int(75, "Minimum Decision Score", minval=50, maxval=100, group=G_MODE)

mom_lookback = input.int(5,  "Momentum Lookback Bars", minval=2, maxval=20, group=G_MOM)
vol_avg_len  = input.int(20, "Volume Average Length",  minval=5,             group=G_MOM)
atr_len      = input.int(14, "ATR Period",             minval=5,             group=G_MOM)
exp_thresh   = input.float(1.5, "Candle Expansion Threshold (x)", minval=1.0, step=0.1, group=G_MOM)

adx_len      = input.int(14,  "ADX Period",       minval=5, group=G_REG)
adx_trend    = input.float(25,"ADX Trend Threshold", minval=10, group=G_REG)
ema_fast_len = input.int(20,  "EMA Fast Period",  minval=5, group=G_REG)
ema_slow_len = input.int(200, "EMA Slow Period",  minval=50, group=G_REG)

ict_lookback = input.int(50, "ICT Lookback Bars",     minval=10,     group=G_ICT)
fvg_min_size = input.float(0.0002, "Min FVG Size",    minval=0.0001, group=G_ICT)
eqh_tol      = input.float(0.001,  "EQH/EQL Tolerance", minval=0.0001, group=G_ICT)

sl_atr_mult  = input.float(2.0, "Stop Loss ATR Multiple", minval=0.5, step=0.25, group=G_EXEC)
tp1_rr       = input.float(1.2, "TP1 Target RR (Safety & BE)", minval=0.5, step=0.1, group=G_EXEC)
tp2_rr       = input.float(2.5, "TP2 Target RR (Structural)", minval=1.0, step=0.1, group=G_EXEC)
tp3_rr       = input.float(4.0, "TP3 Target RR (Expansion Runner)", minval=1.5, step=0.1, group=G_EXEC)
enable_be    = input.bool(true, "Move SL to Break-Even on TP1 Hit", group=G_EXEC)
enable_trail = input.bool(true, "Enable Trailing Stop on Structure", group=G_EXEC)
reset_stats  = input.bool(false, "Reset Performance Analytics", group=G_EXEC)
show_lines   = input.bool(true, "Show Entry / SL / TP Lines", group=G_EXEC)
show_labels  = input.bool(true, "Show Trade Labels",           group=G_EXEC)

// MTF Configuration
use_mtf      = input.bool(true, "Enable MTF Alignment", group=G_MTF)
htf1_res     = input.timeframe("240", "HTF 1 (e.g. 4H)", group=G_MTF)
htf2_res     = input.timeframe("60", "HTF 2 (e.g. 1H)", group=G_MTF)
htf3_res     = input.timeframe("15", "HTF 3 (e.g. 15M)", group=G_MTF)

// Session Hours Configuration (UTC default)
use_sessions = input.bool(true, "Enable Session Rules", group=G_SESS)
sess_asia    = input.session("0000-0900:1234567", "Asian Session Hours", group=G_SESS)
sess_lon     = input.session("0800-1700:1234567", "London Session Hours", group=G_SESS)
sess_ny      = input.session("1300-2200:1234567", "New York Session Hours", group=G_SESS)
sess_tz      = input.string("UTC", "Session Timezone", options=["UTC", "GMT", "America/New_York", "Europe/London"], group=G_SESS)

// Order Flow Configuration
use_oflow    = input.bool(true, "Enable Order Flow Delta & CVD", group=G_OFLOW)
div_lookback = input.int(20, "CVD Divergence Lookback", minval=5, group=G_OFLOW)

// News / Calendar Configuration
use_news     = input.bool(true, "Enable News Gating", group=G_NEWS)
news_block1  = input.session("1315-1415:1234567", "High Impact Hour 1 (CPI/NFP)", group=G_NEWS)
news_block2  = input.session("1845-1945:1234567", "High Impact Hour 2 (FOMC)", group=G_NEWS)

// SMC Visualization Configs
G_SMC_VIZ    = "SMC Visualizations"
show_smc_viz = input.bool(true, "Global SMC Visualization", group=G_SMC_VIZ)
show_pivots  = input.bool(false, "Show HH/HL/LH/LL Labels (Set False if using other indicators)", group=G_SMC_VIZ)
show_bos     = input.bool(true, "Show BOS Lines & Labels", group=G_SMC_VIZ)
show_choch   = input.bool(true, "Show CHoCH Lines & Labels", group=G_SMC_VIZ)
show_fvgs    = input.bool(true, "Show FVG Boxes", group=G_SMC_VIZ)
show_obs     = input.bool(true, "Show Order Block Zones", group=G_SMC_VIZ)
show_sweeps  = input.bool(true, "Show Liquidity sweeps", group=G_SMC_VIZ)
show_vprof   = input.bool(false, "Show Volume Profile POC/VAH/VAL", group=G_SMC_VIZ)

// === Volume Profile & Institutional Benchmarks === (T003)
var string G_VP_INST    = "=== Volume Profile & Institutional Benchmarks ==="
show_session_vp     = input.bool(true, "Show Daily Developing Volume Profile (POC/VAH/VAL)", group=G_VP_INST)
show_vpoc           = input.bool(true, "Show Virgin POC (vPOC) Projections", group=G_VP_INST)
show_asian_range    = input.bool(true, "Show Asian Range & Judas Swings", group=G_VP_INST)
show_midnight_open  = input.bool(true, "Show NY Midnight True Open Benchmark", group=G_VP_INST)
show_cvd_divergence = input.bool(true, "Show Order Flow CVD Delta Absorption", group=G_VP_INST)
show_smt_radar      = input.bool(true, "Show Multi-Asset SMT Divergence Radar", group=G_VP_INST)
smt_symbol          = input.symbol("PEPPERSTONE:XAGUSD", "SMT Benchmark Correlated Symbol", group=G_VP_INST)

// Risk Manager Inputs
G_RISK_MGR   = "Dynamic Risk & Position Sizer"
acct_size    = input.float(10000.0, "Account Balance ($)", minval=100.0, step=100.0, group=G_RISK_MGR)
risk_pct     = input.float(1.0, "Risk Percentage (%)", minval=0.1, maxval=10.0, step=0.1, group=G_RISK_MGR)
sl_mode      = input.string("ATR Multiple", "Stop Loss Mode", options=["ATR Multiple", "Structure Pivot"], group=G_RISK_MGR)

show_hud   = input.bool(true, "Show Dashboard Panel", group=G_DISP)
hud_mode   = input.string("Compact (11 Rows)", "Dashboard Size", options=["Compact (11 Rows)", "Full (34 Rows)", "Hidden"], group=G_DISP)
hud_pos    = input.string("Top Right", "Dashboard Position", options=["Top Right","Top Left","Bottom Right","Bottom Left"], group=G_DISP)
hud_bg     = input.color(color.new(#0d1117, 10),   "HUD Background", group=G_DISP)
hud_txt    = input.color(color.new(color.white, 10), "HUD Text Color", group=G_DISP)

// ============================================================
// ── HELPER: NON-REPAINTING HTF SECURITY WRAPPER (T003)
// ============================================================
f_security_nonrepaint(res, expr) =>
    request.security(syminfo.tickerid, res, expr[1], barmerge.gaps_off, barmerge.lookahead_on)

f_security_symbol_nonrepaint(sym, res, expr) =>
    request.security(sym, res, expr[1], barmerge.gaps_off, barmerge.lookahead_on)

// ============================================================
// ── MODULE 1: MOMENTUM ENGINE
// ── Purpose: Quantify raw price velocity, acceleration, expansion.
// ============================================================
calcMomentum() =>
    atr_v       = ta.atr(atr_len)
    price_chg   = close - close[mom_lookback]
    vel_val     = price_chg / mom_lookback
    abs_vel     = math.abs(vel_val)
    norm_vel    = atr_v > 0 ? abs_vel / (atr_v / mom_lookback) : 0.0

    // Acceleration vs previous window
    vel_prev    = (close[mom_lookback] - close[mom_lookback * 2]) / mom_lookback
    accel       = vel_val - vel_prev

    // Candle expansion vs ATR average
    cur_range   = high - low
    avg_range   = ta.sma(high - low, atr_len)
    exp_ratio   = avg_range > 0 ? cur_range / avg_range : 1.0

    // Candle body quality (reject doji)
    body        = math.abs(close - open)
    body_ratio  = (high - low) > 0 ? body / (high - low) : 0.0

    // Volume vs average
    avg_vol     = ta.sma(volume, vol_avg_len)
    vol_ratio   = avg_vol > 0 ? volume / avg_vol : 1.0

    // Score (0-100)
    s = 0.0
    s += math.min(35.0, norm_vel * 35.0)
    if (accel > 0 and vel_val > 0) or (accel < 0 and vel_val < 0)
        s += 25.0
    else
        s += 10.0
    s += math.min(20.0, (exp_ratio - 1.0) * 20.0)
    s += math.min(20.0, (vol_ratio - 1.0) * 15.0)
    if body_ratio < 0.4
        s *= 0.7
    final_s = int(math.round(math.max(0.0, math.min(100.0, s))))

    vel_lbl   = norm_vel > 1.5 ? "Strong"   : norm_vel > 0.8 ? "Moderate" : "Weak"
    accel_lbl = accel > 0      ? "Increasing" : accel < -atr_v * 0.05 ? "Weakening" : "Neutral"
    vol_lbl   = vol_ratio > 2.0 ? "Very High" : vol_ratio > 1.4 ? "Above Avg" : vol_ratio > 0.7 ? "Normal" : "Low"
    direction = vel_val > 0 ? 1 : vel_val < 0 ? -1 : 0

    [final_s, direction, vel_lbl, accel_lbl, vol_lbl, exp_ratio, vol_ratio]

// ============================================================
// ── MODULE 2: MARKET REGIME DETECTOR
// ── Purpose: Classify market environment using ADX, EMA, structure.
// ============================================================
detectRegime() =>
    [di_plus, di_minus, adx_v] = ta.dmi(adx_len, adx_len)
    ema_f   = ta.ema(close, ema_fast_len)
    ema_s   = ta.ema(close, ema_slow_len)
    bias    = close > ema_s ? 1 : -1
    atr_v   = ta.atr(atr_len)
    atr_pct = close > 0 ? atr_v / close : 0.0
    rsi_val = ta.rsi(close, 14)

    recent_hi = ta.highest(high, 20)
    recent_lo = ta.lowest(low, 20)

    string regime = "RANGING"
    int    conf   = 60

    if atr_pct < 0.0003 or atr_pct > 0.0025
        regime := "HIGH_VOLATILITY"
        conf   := 85
    else if adx_v > 40
        regime := close > ema_s ? "TRENDING_BULLISH" : "TRENDING_BEARISH"
        conf   := int(math.min(95.0, 70.0 + (adx_v - adx_trend) * 0.8))
    else if adx_v > adx_trend
        near_hi = close > recent_hi * 0.998
        near_lo = close < recent_lo * 1.002
        if near_hi or near_lo
            regime := "TRANSITION"
            conf   := 78
        else
            regime := close > ema_s ? "TRENDING_BULLISH" : "TRENDING_BEARISH"
            conf   := int(60.0 + adx_v)
    else
        rsi_v  = rsi_val
        if rsi_v > 68 or rsi_v < 32
            regime := "TRANSITION"
            conf   := 72
        else
            regime := "RANGING"
            conf   := 65

    [regime, conf, bias, adx_v, ema_f, ema_s]

// ============================================================
// ── MODULE 3: VOLATILITY ENGINE
// ── Purpose: ATR-based volatility classification + risk condition.
// ============================================================
calcVolatility() =>
    atr_v   = ta.atr(atr_len)
    atr_pct = close > 0 ? atr_v / close * 100.0 : 0.0

    string vol_state = "NORMAL"
    string vol_cond  = "NEUTRAL"
    int    vol_score = 70

    if atr_pct < 0.04
        vol_state := "LOW"
        vol_cond  := "AVOID SCALPING"
        vol_score := 20
    else if atr_pct > 0.20
        vol_state := "EXTREME"
        vol_cond  := "REDUCE SIZE"
        vol_score := 40
    else if atr_pct > 0.12
        vol_state := "HIGH"
        vol_cond  := "GOOD"
        vol_score := 90
    else
        vol_state := "NORMAL"
        vol_cond  := "NEUTRAL"
        vol_score := 70

    [vol_state, vol_cond, vol_score, atr_v, atr_pct]

// ============================================================
// ── MODULE 4A: ICT MARKET STRUCTURE
// ── Purpose: HH/HL/LH/LL, BOS, CHoCH detection.
// ============================================================
detectStructure() =>
    swing_hi = ta.pivothigh(high, 5, 5)
    swing_lo = ta.pivotlow(low,  5, 5)

    var float ph1 = na
    var float ph2 = na
    var float pl1 = na
    var float pl2 = na
    var int ph1_bar = na
    var int ph2_bar = na
    var int pl1_bar = na
    var int pl2_bar = na

    if not na(swing_hi)
        ph2 := ph1
        ph2_bar := ph1_bar
        ph1 := swing_hi
        ph1_bar := bar_index - 5
    if not na(swing_lo)
        pl2 := pl1
        pl2_bar := pl1_bar
        pl1 := swing_lo
        pl1_bar := bar_index - 5

    string struct_lbl = "NEUTRAL"
    bool   bos_bull   = false
    bool   bos_bear   = false

    if not na(ph1) and not na(ph2) and not na(pl1) and not na(pl2)
        is_hh = ph1 > ph2
        is_hl = pl1 > pl2
        is_lh = ph1 < ph2
        is_ll = pl1 < pl2

        if is_hh and is_hl
            struct_lbl := "BULLISH"
            bos_bull   := true
        else if is_lh and is_ll
            struct_lbl := "BEARISH"
            bos_bear   := true
        else if is_hh and is_ll
            struct_lbl := "CHOCH BULL"
        else if is_lh and is_hl
            struct_lbl := "CHOCH BEAR"

    bias_int = (struct_lbl == "BULLISH" or struct_lbl == "CHOCH BULL") ? 1 : (struct_lbl == "BEARISH" or struct_lbl == "CHOCH BEAR") ? -1 : 0

    // Capture the current values for return (so the outer scope gets the valid level on the breakout bar)
    float ret_ph1 = ph1
    int ret_ph1_bar = ph1_bar
    float ret_pl1 = pl1
    int ret_pl1_bar = pl1_bar

    // Now reset the internal var states if broken, so next bar they are na and don't repeat breakouts
    if not na(ph1) and close > ph1
        ph1 := na
    if not na(pl1) and close < pl1
        pl1 := na

    [struct_lbl, bias_int, bos_bull, bos_bear, ret_ph1, ret_ph1_bar, ph2, ret_pl1, ret_pl1_bar, pl2, swing_hi, swing_lo]

// ============================================================
// ── MODULE 4B: ICT LIQUIDITY
// ── Purpose: Equal Highs/Lows, PDH/PDL, sweep events.
// ============================================================
detectLiquidity() =>
    pdh = request.security(syminfo.tickerid, "D", high[1], barmerge.gaps_off, barmerge.lookahead_on)
    pdl = request.security(syminfo.tickerid, "D", low[1],  barmerge.gaps_off, barmerge.lookahead_on)

    recent_hi = ta.highest(high, ict_lookback)
    prev_hi   = ta.highest(high[1], ict_lookback)
    recent_lo = ta.lowest(low,  ict_lookback)
    prev_lo   = ta.lowest(low[1],  ict_lookback)

    eqh = math.abs(recent_hi - prev_hi) < eqh_tol
    eql = math.abs(recent_lo - prev_lo) < eqh_tol

    bull_sweep = low < pdl and close > pdl
    bear_sweep = high > pdh and close < pdh

    liq_lbl    = eqh ? "EQH Detected" : eql ? "EQL Detected" : bull_sweep ? "SSL Swept" : bear_sweep ? "BSL Swept" : "None"
    liq_active = eqh or eql or bull_sweep or bear_sweep

    [liq_active, liq_lbl, bull_sweep, bear_sweep, pdh, pdl]

// ============================================================
// ── MODULE 4C: ICT FAIR VALUE GAP
// ── Purpose: 3-candle gap detection (bullish / bearish FVG).
// ============================================================
detectFVG() =>
    bull_fvg = (low > high[2]) and ((low - high[2]) >= fvg_min_size)
    bear_fvg = (high < low[2]) and ((low[2] - high) >= fvg_min_size)
    fvg_lbl  = bull_fvg ? "Bullish FVG" : bear_fvg ? "Bearish FVG" : "None"
    [bull_fvg or bear_fvg, fvg_lbl, bull_fvg, bear_fvg]

// ============================================================
// ── MODULE 4D: ICT ORDER BLOCK
// ── Purpose: Last counter-directional candle before impulse move.
// ============================================================
detectOB() =>
    bull_impulse = close > close[1] * 1.002 and close > close[20]
    bear_impulse = close < close[1] * 0.998 and close < close[20]
    bull_ob = bull_impulse and close[1] < open[1]
    bear_ob = bear_impulse and close[1] > open[1]
    ob_lbl  = bull_ob ? "Bullish OB" : bear_ob ? "Bearish OB" : "None"
    [bull_ob or bear_ob, ob_lbl, bull_ob, bear_ob]

// ============================================================
// ── MODULE 4E: PREMIUM / DISCOUNT ZONE
// ============================================================
getPD() =>
    rng_hi  = ta.highest(high, 50)
    rng_lo  = ta.lowest(low,  50)
    pct     = (rng_hi - rng_lo) > 0 ? (close - rng_lo) / (rng_hi - rng_lo) * 100 : 50.0
    zone    = pct > 70 ? "PREMIUM" : pct < 30 ? "DISCOUNT" : "EQUILIBRIUM"
    [zone, pct, rng_hi, rng_lo]

// ============================================================
// ── MODULE 8: MULTI-TIMEFRAME ALIGNMENT ENGINE
// ── Purpose: Gather HTF trend and structural bias to build confluence.
// ============================================================
// HTF 1 (e.g. 4H) - Strictly non-repainting with native HTF EMA (T006 & T007)
htf1_close = f_security_nonrepaint(htf1_res, close)
htf1_ema   = request.security(syminfo.tickerid, htf1_res, ta.ema(close, ema_slow_len)[1], barmerge.gaps_off, barmerge.lookahead_on)
htf1_bias  = htf1_close > htf1_ema ? 1 : -1

// HTF 2 (e.g. 1H) - Strictly non-repainting with native HTF EMA (T006 & T007)
htf2_close = f_security_nonrepaint(htf2_res, close)
htf2_ema   = request.security(syminfo.tickerid, htf2_res, ta.ema(close, ema_slow_len)[1], barmerge.gaps_off, barmerge.lookahead_on)
htf2_bias  = htf2_close > htf2_ema ? 1 : -1

// HTF 3 (e.g. 15M) - Strictly non-repainting with native HTF EMA (T006 & T007)
htf3_close = f_security_nonrepaint(htf3_res, close)
htf3_ema   = request.security(syminfo.tickerid, htf3_res, ta.ema(close, ema_slow_len)[1], barmerge.gaps_off, barmerge.lookahead_on)
htf3_bias  = htf3_close > htf3_ema ? 1 : -1

calcMTF() =>
    string m_status = "MIXED"
    int    m_score  = 50
    int    align_b  = 0
    if use_mtf
        if htf1_bias == 1 and htf2_bias == 1 and htf3_bias == 1
            m_status := "BULLISH"
            m_score  := 100
            align_b  := 1
        else if htf1_bias == -1 and htf2_bias == -1 and htf3_bias == -1
            m_status := "BEARISH"
            m_score  := 100
            align_b  := -1
        else
            m_status := "MIXED"
            m_score  := 50
            align_b  := 0
    [m_status, m_score, align_b]

// ============================================================
// ── MODULE 9: SESSION FILTER ENGINE
// ── Purpose: Identify active trading sessions and boost open setups.
// ============================================================
in_session(sess_spec, tz_spec) =>
    not na(time(timeframe.period, sess_spec, tz_spec))

detectSession() =>
    is_asia   = use_sessions and in_session(sess_asia, sess_tz)
    is_london = use_sessions and in_session(sess_lon, sess_tz)
    is_ny     = use_sessions and in_session(sess_ny, sess_tz)

    string act_sess = "OFF-HOURS"
    int    sess_bst = 0

    if is_london and is_ny
        act_sess := "LDN / NY OVERLAP"
        sess_bst := 15
    else if is_ny
        act_sess := "NEW YORK"
        sess_bst := 15
    else if is_london
        act_sess := "LONDON"
        sess_bst := 15
    else if is_asia
        act_sess := "ASIA"
        sess_bst := -5
    else
        act_sess := "OFF-HOURS"
        sess_bst := -10

    [act_sess, sess_bst, is_asia, is_london, is_ny]

// ============================================================
// ── MODULE 10: ORDER FLOW ENGINE (DELTA & CVD)
// ── Purpose: Estimate buying/selling delta pressure and CVD divergences.
// ============================================================
// Volume delta calculation (Intrabar Volume Delta approximation)
candle_range = high - low
buy_pct      = candle_range > 0 ? (close - low) / candle_range : 0.5
sell_pct     = 1.0 - buy_pct

buy_vol   = volume * buy_pct
sell_vol  = volume * sell_pct
vol_delta = buy_vol - sell_vol

// Normalized delta percentage
delta_pct = volume > 0 ? (vol_delta / volume) * 100.0 : 0.0

// CVD series
var float cvd_val = 0.0
if barstate.isfirst
    cvd_val := 0.0
else
    cvd_val := cvd_val + vol_delta

// CVD divergence detection (pivot highs/lows)
p_hi = ta.pivothigh(high, 5, 5)
p_lo = ta.pivotlow(low,  5, 5)
c_hi = ta.pivothigh(cvd_val, 5, 5)
c_lo = ta.pivotlow(cvd_val, 5, 5)

var float last_p_hi_val = na
var int   last_p_hi_bar = na
var float last_c_hi_val = na

var float last_p_lo_val = na
var int   last_p_lo_bar = na
var float last_c_lo_val = na

if not na(p_hi)
    last_p_hi_val := p_hi
    last_p_hi_bar := bar_index[5]
if not na(c_hi)
    last_c_hi_val := c_hi

if not na(p_lo)
    last_p_lo_val := p_lo
    last_p_lo_bar := bar_index[5]
if not na(c_lo)
    last_c_lo_val := c_lo

calcOrderFlow() =>
    bool bear_div = false
    bool bull_div = false

    if not na(p_hi) and not na(last_p_hi_val) and (bar_index[5] - last_p_hi_bar < div_lookback)
        if high[5] > last_p_hi_val and cvd_val[5] < last_c_hi_val
            bear_div := true
    if not na(p_lo) and not na(last_p_lo_val) and (bar_index[5] - last_p_lo_bar < div_lookback)
        if low[5] < last_p_lo_val and cvd_val[5] > last_c_lo_val
            bull_div := true

    int of_score = 50
    if delta_pct > 20.0
        of_score += 15
    else if delta_pct < -20.0
        of_score -= 15

    if bull_div
        of_score += 25
    if bear_div
        of_score -= 25

    of_score_clipped = int(math.max(0.0, math.min(100.0, of_score)))
    string of_lbl = bull_div ? "Bullish Div" : bear_div ? "Bearish Div" : "Neutral"

    [of_score_clipped, of_lbl, delta_pct, cvd_val]

// ============================================================
// ── MODULE 11: NEWS CALENDAR FILTER GATING
// ── Purpose: Exclude high-impact hours (CPI, FOMC, etc.) from entry rules.
// ============================================================
checkNewsGating() =>
    is_news_1 = use_news and in_session(news_block1, sess_tz)
    is_news_2 = use_news and in_session(news_block2, sess_tz)
    active    = is_news_1 or is_news_2
    string lbl = active ? "NEWS ACTIVE" : "SAFE"
    [active, lbl]

// ============================================================
// ── MODULE 1.5: VOLUME PROFILE (POC / VAH / VAL)
// ── Purpose: Estimate point of control and value area bounds.
// ============================================================
// T004 & T005: 20-bin Session Volume Profile with 70% Value Area
calcSessionVolumeProfile(lookback_len) =>
    lb = math.max(1, lookback_len)
    hi_price = high
    lo_price = low
    for i = 0 to lb - 1
        hi_price := math.max(hi_price, high[i])
        lo_price := math.min(lo_price, low[i])
    bin_size = (hi_price - lo_price) / 20.0 // bin_count: fixed at 20 bins per daily range
    bin_vols = array.new_float(20, 0.0)
    
    for i = 0 to lb - 1
        bar_close = close[i]
        bar_vol   = na(volume[i]) ? 0.0 : volume[i]
        if bin_size > 0
            bin_index = math.min(19, math.max(0, math.floor((bar_close - lo_price) / bin_size)))
            array.set(bin_vols, bin_index, array.get(bin_vols, bin_index) + bar_vol)
            
    max_vol = -1.0
    poc_index = 0
    total_vol = 0.0
    for j = 0 to 19
        v = array.get(bin_vols, j)
        total_vol := total_vol + v
        if v > max_vol
            max_vol := v
            poc_index := j
            
    poc_price = bin_size > 0 ? lo_price + (poc_index + 0.5) * bin_size : close
    
    // Accumulate 70% of total volume for Value Area
    double_va_target = total_vol * 0.70
    accum_vol = array.get(bin_vols, poc_index)
    left_idx = poc_index
    right_idx = poc_index
    
    for k = 1 to 19
        if accum_vol >= double_va_target
            break
        left_val  = left_idx > 0 ? array.get(bin_vols, left_idx - 1) : 0.0
        right_val = right_idx < 19 ? array.get(bin_vols, right_idx + 1) : 0.0
        if left_val >= right_val and left_idx > 0
            left_idx  := left_idx - 1
            accum_vol := accum_vol + left_val
        else if right_idx < 19
            right_idx := right_idx + 1
            accum_vol := accum_vol + right_val
            
    vah_price = bin_size > 0 ? lo_price + (right_idx + 1) * bin_size : close
    val_price = bin_size > 0 ? lo_price + left_idx * bin_size : close
    [poc_price, vah_price, val_price]

// ============================================================
// ── MODULE 5: DECISION SCORING ENGINE (AI Explanation Layer)
// ── Purpose: Weighted multi-factor confluence score (0-100).
// ============================================================
calcDecisionScore(m_s, v_s, regime, bias, struct_bias, liq, fvg, ob, pd_zone, mtf_sc, sess_bst, of_sc, news_act, dec_dir, vol_rat, inst_bonus) =>
    c_mom    = 0.0
    c_reg    = 0.0
    c_vol    = 0.0
    c_struct = 0.0
    c_liq    = 0.0
    c_fvg    = 0.0
    c_ob     = 0.0
    c_pd     = 0.0
    c_mtf    = 0.0
    c_of     = 0.0
    c_sess   = 0.0
    c_exec   = 0.0
    s        = 0.0
    
    if not news_act
        if mode == "MQL5 Engine Parity (v0.50)"
            // T010: Exact 10-Component Matrix matching EntryQualityEngine.mqh (Total = 100 pts)
            // 1. Structure (20 pts)
            c_struct := (struct_bias != 0 ? 20.0 : 5.0)
            // 2. Liquidity (15 pts)
            c_liq    := (liq ? 15.0 : 3.0)
            // 3. FVG Imbalance (15 pts)
            c_fvg    := (fvg ? 15.0 : 3.0)
            // 4. Displacement / Momentum (10 pts)
            c_mom    := (m_s >= 65 ? 10.0 : m_s >= 50 ? 5.0 : 0.0)
            // 5. Session Alignment (10 pts)
            c_sess   := (sess_bst > 0 ? 10.0 : sess_bst == 0 ? 5.0 : 0.0)
            // 6. HTF Bias Alignment (10 pts)
            c_mtf    := (mtf_sc == 100 ? 10.0 : mtf_sc == 50 ? 5.0 : 0.0)
            // 7. Premium / Discount (10 pts)
            pd_score = 5.0
            if dec_dir == 1
                pd_score := pd_zone == "DISCOUNT" ? 10.0 : pd_zone == "EQUILIBRIUM" ? 5.0 : 1.0
            else if dec_dir == -1
                pd_score := pd_zone == "PREMIUM" ? 10.0 : pd_zone == "EQUILIBRIUM" ? 5.0 : 1.0
            c_pd     := pd_score
            // 8. Order Flow / CVD (5 pts)
            c_of     := (of_sc >= 75 ? 5.0 : of_sc >= 50 ? 2.5 : 0.0)
            // 9. Volume Ratio (3 pts)
            c_vol    := (vol_rat >= 1.4 ? 3.0 : vol_rat >= 1.0 ? 1.5 : 0.0)
            // 10. News Clearance (2 pts)
            c_exec   := (not news_act ? 2.0 : 0.0)
            
            s := c_struct + c_liq + c_fvg + c_mom + c_sess + c_mtf + c_pd + c_of + c_vol + c_exec
        else if mode == "Momentum Scalper"
            // Momentum 25% | Regime 15% | Volatility 10% | Structure 15% | MTF 10% | OF 10% | Session 5% | Exec 10%
            c_mom    := m_s * 0.25
            
            rp = str.contains(regime, "BULL") or str.contains(regime, "BEAR") ? 100.0 : regime == "TRANSITION" ? 80.0 : regime == "HIGH_VOLATILITY" ? 20.0 : 40.0
            c_reg    := rp * 0.15
            
            c_vol    := v_s * 0.10
            c_struct := (struct_bias != 0 ? 100.0 : 40.0) * 0.15
            c_mtf    := mtf_sc * 0.10
            c_of     := of_sc * 0.10
            c_sess   := (sess_bst >= 0 ? 100.0 : 30.0) * 0.05
            c_exec   := (math.abs(bias) == 1 ? 100.0 : 50.0) * 0.10
            
            s := c_mom + c_reg + c_vol + c_struct + c_mtf + c_of + c_sess + c_exec + sess_bst
        else
            // ICT Sniper Mode: Structure 25% | Liquidity 15% | FVG 10% | OB 10% | Premium/Discount 10% | MTF 10% | OF 10% | Session 5% | Exec 5%
            c_struct := (struct_bias != 0 ? 100.0 : 30.0) * 0.25
            c_liq    := (liq ? 100.0 : 25.0)             * 0.15
            c_fvg    := (fvg ? 100.0 : 20.0)             * 0.10
            c_ob     := (ob  ? 100.0 : 20.0)             * 0.10
            
            pd_score = 50.0
            if dec_dir == 1
                pd_score := pd_zone == "DISCOUNT" ? 100.0 : pd_zone == "PREMIUM" ? 10.0 : 50.0
            else if dec_dir == -1
                pd_score := pd_zone == "PREMIUM" ? 100.0 : pd_zone == "DISCOUNT" ? 10.0 : 50.0
            c_pd     := pd_score * 0.10
            
            c_mtf    := mtf_sc                            * 0.10
            c_of     := of_sc                            * 0.10
            c_sess   := (sess_bst >= 0 ? 100.0 : 30.0) * 0.05
            c_exec   := (math.abs(bias) == 1 ? 100.0 : 50.0) * 0.05
            
            s := c_struct + c_liq + c_fvg + c_ob + c_pd + c_mtf + c_of + c_sess + c_exec + sess_bst

    // T013 & T022: Institutional Confluence Bonus (max +10 pts)
    c_inst = math.min(10.0, math.max(0.0, inst_bonus))
    s := math.min(100.0, s + c_inst)

    sc    = int(math.round(math.max(0.0, math.min(100.0, s))))
    grade = sc >= 90 ? "A+" : sc >= 80 ? "A" : sc >= 70 ? "B" : sc >= 60 ? "C" : "F"
    [sc, grade, c_mom, c_reg, c_vol, c_struct, c_liq, c_fvg, c_ob, c_pd, c_mtf, c_of, c_sess, c_exec, c_inst]

// ============================================================
// ── RUN ALL MODULES (confirmed bars — no repainting)
// ============================================================
[mom_s, mom_dir, vel_lbl, accel_lbl, vol_lbl, exp_ratio, vol_ratio_v] = calcMomentum()
[regime_lbl, regime_conf, ema_bias_v, adx_v, ema_f_v, ema_s_v]       = detectRegime()
[vol_state, vol_cond, vol_score, atr_v, atr_pct_v]                    = calcVolatility()
[struct_lbl, struct_bias_v, bos_b, bos_s, ph1, ph1_bar, ph2, pl1, pl1_bar, pl2, swing_hi, swing_lo] = detectStructure()
[liq_active, liq_lbl, bull_sweep_v, bear_sweep_v, pdh_v, pdl_v]       = detectLiquidity()
[fvg_active, fvg_lbl, bull_fvg_v, bear_fvg_v]                         = detectFVG()
[ob_active,  ob_lbl,  bull_ob_v, bear_ob_v]                            = detectOB()
[pd_zone, pd_pct, rng_hi_v, rng_lo_v]                                  = getPD()

// Pro modules execution
[mtf_status, mtf_score, mtf_align_bias]                               = calcMTF()
[act_sess, sess_bst, is_asia, is_london, is_ny]                       = detectSession()
[of_score, of_lbl, delta_pct_v, cvd_val_v]                            = calcOrderFlow()
[news_active, news_lbl]                                               = checkNewsGating()

// ============================================================
// ── MODULE 12: VOLUME PROFILE & INSTITUTIONAL BENCHMARKS ENGINE
// ── (US1: Session POC/VAH/VAL, vPOC, 80% Rule | US2: Asian Judas, True Open | US3: CVD Absorpt | US4: SMT)
// ============================================================
is_new_day = ta.change(time("D")) != 0

// 1. Developing Daily Volume Profile (US1 - FR-001)
var int   day_start_bar  = 0
var float dev_poc        = na
var float dev_vah        = na
var float dev_val        = na
var float yesterday_poc  = na

// Persistent Virgin POC Tracking Registry (US1 - FR-002, Max 3 vPOCs)
var float[] virgin_pocs       = array.new_float(0)
var line[]  virgin_poc_lines  = array.new_line(0)
var label[] virgin_poc_labels = array.new_label(0)

if is_new_day
    if not na(dev_poc)
        yesterday_poc := dev_poc
        if show_vpoc
            if array.size(virgin_pocs) >= 3
                old_l = array.shift(virgin_poc_lines)
                old_b = array.shift(virgin_poc_labels)
                array.shift(virgin_pocs)
                line.delete(old_l)
                label.delete(old_b)
            array.push(virgin_pocs, yesterday_poc)
            vl = line.new(bar_index, yesterday_poc, bar_index + 10, yesterday_poc, extend=extend.right, color=color.new(#f59e0b, 20), width=1, style=line.style_dashed)
            vlbl = label.new(bar_index, yesterday_poc, "vPOC " + str.tostring(yesterday_poc, "#.##"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 100), textcolor=#f59e0b, size=size.tiny)
            array.push(virgin_poc_lines, vl)
            array.push(virgin_poc_labels, vlbl)
    day_start_bar := bar_index

cur_day_bars = bar_index - day_start_bar + 1
[cur_poc, cur_vah, cur_val] = calcSessionVolumeProfile(cur_day_bars)
dev_poc := cur_poc
dev_vah := cur_vah
dev_val := cur_val

// Dynamic Touch-Termination for Virgin POCs (US1 - FR-002: low <= vpoc and high >= vpoc)
var bool vpoc_touched = false
vpoc_touched := false
if show_vpoc and array.size(virgin_pocs) > 0
    for idx = array.size(virgin_pocs) - 1 to 0
        vp = array.get(virgin_pocs, idx)
        if high >= vp and low <= vp
            vpoc_touched := true
            cur_l = array.get(virgin_poc_lines, idx)
            cur_b = array.get(virgin_poc_labels, idx)
            line.set_x2(cur_l, bar_index)
            line.set_extend(cur_l, extend.none)
            label.set_x(cur_b, bar_index)
            label.set_text(cur_b, "vPOC Mitigated ✖")
            label.set_textcolor(cur_b, color.gray)
            array.remove(virgin_pocs, idx)
            array.remove(virgin_poc_lines, idx)
            array.remove(virgin_poc_labels, idx)

// Market Profile 80% Rule State Machine (US1 - FR-006: 2 consecutive closes inside Value Area)
var int  va_reentry_count  = 0
var bool va_80_rule_active = false
var int  va_reentry_dir    = 0

if is_new_day
    va_reentry_count  := 0
    va_80_rule_active := false
    va_reentry_dir    := 0

opened_above_va = open[cur_day_bars - 1] > dev_vah
opened_below_va = open[cur_day_bars - 1] < dev_val

if (opened_above_va or opened_below_va) and not va_80_rule_active
    inside_va = close <= dev_vah and close >= dev_val
    if inside_va
        va_reentry_count += 1
        if va_reentry_count >= 2
            va_80_rule_active := true
            va_reentry_dir    := opened_above_va ? -1 : 1
    else
        va_reentry_count := 0

// 2. Institutional Time Benchmarks & Asian Judas Swings (US2 - FR-003, FR-004, FR-005)
in_asia_session = not na(time(timeframe.period, "0000-0800:1234567", "UTC"))
var float asia_range_hi  = na
var float asia_range_lo  = na
var int   asia_start_idx = na

if is_new_day
    asia_range_hi  := na
    asia_range_lo  := na
    asia_start_idx := na

if in_asia_session
    if na(asia_start_idx)
        asia_start_idx := bar_index
        asia_range_hi  := high
        asia_range_lo  := low
    else
        asia_range_hi  := math.max(asia_range_hi, high)
        asia_range_lo  := math.min(asia_range_lo, low)

// London Killzone Judas Swing Detection (08:00 - 11:00 UTC)
in_london_killzone   = not na(time(timeframe.period, "0800-1100:1234567", "UTC"))
var bool judas_bull_sweep = false
var bool judas_bear_sweep = false
judas_bull_sweep := false
judas_bear_sweep := false

if show_asian_range and in_london_killzone and not na(asia_range_hi) and not na(asia_range_lo)
    if low < asia_range_lo and close > asia_range_lo
        judas_bull_sweep := true
    if high > asia_range_hi and close < asia_range_hi
        judas_bear_sweep := true

judas_swing_detected = judas_bull_sweep or judas_bear_sweep

// New York Midnight Open Benchmark (00:00 EST / 04:00 UTC) (US2 - FR-004)
var float ny_midnight_open = na
is_midnight_candle = hour(time, "America/New_York") == 0 and minute(time, "America/New_York") == 0
if is_midnight_candle
    ny_midnight_open := open

is_daily_discount = not na(ny_midnight_open) and close < ny_midnight_open
is_daily_premium  = not na(ny_midnight_open) and close > ny_midnight_open

// 3. Order Flow CVD Delta Absorption at Volume Nodes (US3 - FR-007)
dist_to_poc = not na(dev_poc) and dev_poc > 0 ? math.abs(close - dev_poc) / dev_poc : 1.0
dist_to_val = not na(dev_val) and dev_val > 0 ? math.abs(close - dev_val) / dev_val : 1.0
dist_to_vah = not na(dev_vah) and dev_vah > 0 ? math.abs(close - dev_vah) / dev_vah : 1.0
near_vol_node = dist_to_poc < 0.003 or dist_to_val < 0.003 or dist_to_vah < 0.003

bool cvd_bull_absorp = false
bool cvd_bear_absorp = false
if show_cvd_divergence and near_vol_node
    if of_lbl == "Bullish Div"
        cvd_bull_absorp := true
    if of_lbl == "Bearish Div"
        cvd_bear_absorp := true

// 4. Multi-Asset SMT Divergence Radar (US4)
bench_high = show_smt_radar ? f_security_symbol_nonrepaint(smt_symbol, timeframe.period, high) : na
bench_low  = show_smt_radar ? f_security_symbol_nonrepaint(smt_symbol, timeframe.period, low)  : na

var bool smt_bull_div = false
var bool smt_bear_div = false
smt_bull_div := false
smt_bear_div := false

if show_smt_radar and not na(bench_high) and not na(bench_low)
    b_hi = ta.pivothigh(bench_high, 5, 5)
    b_lo = ta.pivotlow(bench_low, 5, 5)
    if not na(p_hi) and not na(last_p_hi_val) and (high[5] > last_p_hi_val) and not na(b_hi)
        if b_hi < ta.highest(bench_high, 20)[5]
            smt_bear_div := true
    if not na(p_lo) and not na(last_p_lo_val) and (low[5] < last_p_lo_val) and not na(b_lo)
        if b_lo > ta.lowest(bench_low, 20)[5]
            smt_bull_div := true

// 5. Calculate Consolidated Institutional Bonus Points (FR-008, Max +10 pts)
inst_bonus = 0.0
if near_vol_node or vpoc_touched
    inst_bonus += 5.0
if judas_swing_detected or va_80_rule_active
    inst_bonus += 5.0
if smt_bull_div or smt_bear_div
    inst_bonus += 5.0
if cvd_bull_absorp or cvd_bear_absorp
    inst_bonus += 5.0

// Estimate potential direction before final scorecard
potential_dir = 0
if struct_bias_v == 1 or bull_sweep_v or bull_fvg_v or bull_ob_v or judas_bull_sweep or (va_80_rule_active and va_reentry_dir == 1)
    potential_dir := 1
else if struct_bias_v == -1 or bear_sweep_v or bear_fvg_v or bear_ob_v or judas_bear_sweep or (va_80_rule_active and va_reentry_dir == -1)
    potential_dir := -1

[dec_score, dec_grade, c_mom, c_reg, c_vol, c_struct, c_liq, c_fvg, c_ob, c_pd, c_mtf, c_of, c_sess, c_exec, c_inst] = calcDecisionScore(mom_s, vol_score, regime_lbl, ema_bias_v, struct_bias_v, liq_active, fvg_active, ob_active, pd_zone, mtf_score, sess_bst, of_score, news_active, potential_dir, vol_ratio_v, inst_bonus)

// ============================================================
// ── SIGNAL LOGIC (barstate.isconfirmed — no repainting)
// ============================================================
bool buy_signal  = false
bool sell_signal = false

if barstate.isconfirmed
    if mode == "MQL5 Engine Parity (v0.50)"
        regime_ok = regime_lbl != "HIGH_VOLATILITY" and regime_lbl != "RANGING"
        buy_signal  := struct_bias_v == 1 and (bull_fvg_v or bull_ob_v or bull_sweep_v) and regime_ok and dec_score >= math.max(60, min_score) and not news_active
        sell_signal := struct_bias_v == -1 and (bear_fvg_v or bear_ob_v or bear_sweep_v) and regime_ok and dec_score >= math.max(60, min_score) and not news_active
    else if mode == "Momentum Scalper"
        buy_signal  := mom_dir == 1 and mom_s >= 65 and ema_bias_v == 1 and (vol_state == "NORMAL" or vol_state == "HIGH") and (regime_lbl == "TRENDING_BULLISH" or regime_lbl == "TRANSITION") and dec_score >= min_score and not news_active
        sell_signal := mom_dir == -1 and mom_s >= 65 and ema_bias_v == -1 and (vol_state == "NORMAL" or vol_state == "HIGH") and (regime_lbl == "TRENDING_BEARISH" or regime_lbl == "TRANSITION") and dec_score >= min_score and not news_active
    else
        buy_signal  := struct_bias_v == 1 and liq_active and (bull_fvg_v or bull_ob_v) and pd_zone == "DISCOUNT" and regime_lbl != "HIGH_VOLATILITY" and dec_score >= min_score and not news_active
        sell_signal := struct_bias_v == -1 and liq_active and (bear_fvg_v or bear_ob_v) and pd_zone == "PREMIUM" and regime_lbl != "HIGH_VOLATILITY" and dec_score >= min_score and not news_active

// ============================================================
// ── SIGNAL SHAPE PLOTS (Confirmed closed candles only — Zero repainting/flickering)
// ============================================================
plotshape(barstate.isconfirmed and buy_signal,  "BUY Signal",  shape.triangleup,   location.belowbar, color=#22c55e, size=size.normal)
plotshape(barstate.isconfirmed and sell_signal, "SELL Signal", shape.triangledown,  location.abovebar, color=#ef4444, size=size.normal)

// Institutional Confluence Visual Markers (Confirmed only)
plotshape(barstate.isconfirmed and show_asian_range and judas_bull_sweep, "Bullish Judas Sweep", shape.labelup, location.belowbar, color=#f59e0b, text="JUDAS", textcolor=color.black, size=size.tiny)
plotshape(barstate.isconfirmed and show_asian_range and judas_bear_sweep, "Bearish Judas Sweep", shape.labeldown, location.abovebar, color=#f59e0b, text="JUDAS", textcolor=color.black, size=size.tiny)

plotshape(barstate.isconfirmed and show_cvd_divergence and cvd_bull_absorp, "Bullish CVD Absorption", shape.diamond, location.belowbar, color=#06b6d4, size=size.tiny)
plotshape(barstate.isconfirmed and show_cvd_divergence and cvd_bear_absorp, "Bearish CVD Absorption", shape.diamond, location.abovebar, color=#ec4899, size=size.tiny)

plotshape(barstate.isconfirmed and show_smt_radar and smt_bull_div, "Bullish SMT Divergence", shape.labelup, location.belowbar, color=#3b82f6, text="SMT", textcolor=color.white, size=size.tiny)
plotshape(barstate.isconfirmed and show_smt_radar and smt_bear_div, "Bearish SMT Divergence", shape.labeldown, location.abovebar, color=#f97316, text="SMT", textcolor=color.white, size=size.tiny)

// ============================================================
// ── EMA PLOTS + PDH/PDL REFERENCE
// ============================================================
plot(ema_f_v, "EMA Fast", color=color.new(#38bdf8, 40), linewidth=1, display=display.all - display.price_scale)
plot(ema_s_v, "EMA Slow", color=color.new(#f59e0b, 40), linewidth=2, display=display.all - display.price_scale)
plot(pdh_v,   "PDH",      color=color.new(#ef4444, 60), linewidth=1, style=plot.style_circles, display=display.all - display.price_scale)
plot(pdl_v,   "PDL",      color=color.new(#22c55e, 60), linewidth=1, style=plot.style_circles, display=display.all - display.price_scale)

// ============================================================
// ── MODULE 6: PERSISTENT TRADE VISUALIZATION SYSTEM
// ── Full lifecycle: SIGNAL → ENTRY → ACTIVE → TP/SL HIT → EXIT
// ──
// ── Layout on chart:
// ============================================================

// Persistent trade state
var float  trade_entry = na    // Active entry price
var float  trade_sl    = na    // Active stop loss
var float  trade_tp1   = na    // Active TP1
var float  trade_tp2   = na    // Active TP2
var float  trade_tp3   = na    // Active TP3 (Runner)
var bool   tp1_hit     = false
var bool   tp2_hit     = false
var bool   tp3_hit     = false
var int    trade_dir   = 0     // 1 = BUY, -1 = SELL, 0 = flat
var int    trade_bar   = na    // Bar index when trade opened
var int    trade_score = na    // Decision score at entry
var string trade_grade = na    // Grade at entry
var float  trade_lot   = na    // Dynamic lot sizing at entry
var string trade_pattern = ""  // Setup pattern name
var string trade_sess    = ""  // Open session name

// Performance Analytics variables
var int    total_trades_count = 0
var int    wins_count         = 0
var float  net_r_gained       = 0.0
var float  max_r_drawdown     = 0.0
var float  peak_net_r         = 0.0

// Session stats trackers
var int london_trades   = 0
var int london_wins     = 0
var int ny_trades       = 0
var int ny_wins         = 0
var int asia_trades     = 0
var int asia_wins       = 0

// Pattern stats trackers
var int pat_rev_trades  = 0
var int pat_rev_wins    = 0
var int pat_cont_trades = 0
var int pat_cont_wins   = 0
var int pat_brk_trades  = 0
var int pat_brk_wins    = 0

// T018: Score-band stats trackers
var int band_90_trades = 0
var int band_90_wins   = 0
var int band_80_trades = 0
var int band_80_wins   = 0
var int band_70_trades = 0
var int band_70_wins   = 0
var int band_60_trades = 0
var int band_60_wins   = 0

// Reset stats if requested
if reset_stats
    total_trades_count := 0
    wins_count         := 0
    net_r_gained       := 0.0
    max_r_drawdown     := 0.0
    peak_net_r         := 0.0
    london_trades      := 0
    london_wins        := 0
    ny_trades          := 0
    ny_wins            := 0
    asia_trades        := 0
    asia_wins          := 0
    pat_rev_trades     := 0
    pat_rev_wins       := 0
    pat_cont_trades    := 0
    pat_cont_wins      := 0
    pat_brk_trades     := 0
    pat_brk_wins       := 0
    band_90_trades     := 0
    band_90_wins       := 0
    band_80_trades     := 0
    band_80_wins       := 0
    band_70_trades     := 0
    band_70_wins       := 0
    band_60_trades     := 0
    band_60_wins       := 0

// Drawing objects — one set, reused across trades
var line  ln_entry   = na      // Entry horizontal line
var line  ln_sl      = na      // SL horizontal line
var line  ln_tp1     = na      // TP1 horizontal line
var line  ln_tp2     = na      // TP2 horizontal line
var line  ln_tp3     = na      // TP3 horizontal line
var label lbl_entry  = na      // Signal candle label
var label lbl_sl     = na      // SL level label
var label lbl_tp1    = na      // TP1 level label
var label lbl_tp2    = na      // TP2 level label
var label lbl_tp3    = na      // TP3 level label
var label lbl_status = na      // Live status label

// ── Define active setup pattern name
setup_pattern = "MOMENTUM SCALP"
if mode == "ICT Sniper"
    if liq_active and (struct_lbl == "CHOCH BULL" or struct_lbl == "CHOCH BEAR")
        setup_pattern := "ICT REVERSAL"
    else if (struct_lbl == "BULLISH" or struct_lbl == "BEARISH") and (fvg_active or ob_active)
        setup_pattern := "TREND CONTINUATION"
    else if pd_zone == "DISCOUNT" or pd_zone == "PREMIUM"
        setup_pattern := "ZONE MITIGATION"
    else
        setup_pattern := "ICT SNIPER SETUP"
else
    if regime_lbl == "TRANSITION" and vol_ratio_v > 1.4
        setup_pattern := "RANGE BREAKOUT"
    else if vel_lbl == "Strong" and accel_lbl == "Increasing"
        setup_pattern := "MOMENTUM CONTINUE"
    else
        setup_pattern := "SCALPER EXPANSION"

// ── Global Trade State & Execution Targets (Always in Scope)
trade_active = trade_dir != 0 and not na(trade_entry)

float curr_sl_px = na
if sl_mode == "Structure Pivot"
    curr_sl_px := (buy_signal or struct_bias_v == 1) ? pl1 : ph1
if na(curr_sl_px) or curr_sl_px <= 0.0
    sl_dist = atr_v * sl_atr_mult
    curr_sl_px := (buy_signal or struct_bias_v == 1) ? close - sl_dist : close + sl_dist

curr_sl_dist = math.abs(close - curr_sl_px)
curr_lot_size = (acct_size * (risk_pct / 100.0)) / (curr_sl_dist * syminfo.pointvalue)
curr_lot_size := math.max(0.01, math.round(curr_lot_size * 100.0) / 100.0)

// Current or Projected Execution Targets (TP1, TP2, TP3, SL)
float disp_entry = trade_active ? trade_entry : close
float disp_sl    = trade_active ? trade_sl : curr_sl_px
float disp_sl_dist = math.max(syminfo.mintick * 10, math.abs(disp_entry - disp_sl))
int   disp_dir   = trade_active ? trade_dir : (buy_signal or struct_bias_v == 1 ? 1 : -1)

float disp_tp1   = trade_active and not na(trade_tp1) ? trade_tp1 : (disp_dir == 1 ? disp_entry + disp_sl_dist * tp1_rr : disp_entry - disp_sl_dist * tp1_rr)
float disp_tp2   = trade_active and not na(trade_tp2) ? trade_tp2 : (disp_dir == 1 ? disp_entry + disp_sl_dist * tp2_rr : disp_entry - disp_sl_dist * tp2_rr)
float disp_tp3   = trade_active and not na(trade_tp3) ? trade_tp3 : (disp_dir == 1 ? disp_entry + disp_sl_dist * tp3_rr : disp_entry - disp_sl_dist * tp3_rr)

string tp1_txt = str.tostring(disp_tp1, "#.##") + (trade_active and tp1_hit ? " ✓" : "")
string tp2_txt = str.tostring(disp_tp2, "#.##") + (trade_active and tp2_hit ? " ✓" : "")
string tp3_txt = str.tostring(disp_tp3, "#.##") + (trade_active and tp3_hit ? " ✓" : "")
string sl_txt  = str.tostring(disp_sl, "#.##") + (trade_active and trade_sl == trade_entry ? " (BE)" : "")

// ── Trade Lifecycle — gated behind barstate.isconfirmed
if barstate.isconfirmed

    // ── Active Trade Check
    trade_active := trade_dir != 0 and not na(trade_entry)

    // ── Module 15: Trailing Stop Logic (Structure-based)
    if trade_active and enable_trail
        if trade_dir == 1 and not na(p_lo) and p_lo > trade_sl
            trade_sl := p_lo
            if not na(ln_sl)
                line.set_y1(ln_sl, trade_sl)
                line.set_y2(ln_sl, trade_sl)
        else if trade_dir == -1 and not na(p_hi) and p_hi < trade_sl
            trade_sl := p_hi
            if not na(ln_sl)
                line.set_y1(ln_sl, trade_sl)
                line.set_y2(ln_sl, trade_sl)

    // ── Target Hit Checks (Bar closed OHLC check)
    tp1_triggered = trade_active and trade_dir == 1 and not tp1_hit and high >= trade_tp1
    tp2_triggered = trade_active and trade_dir == 1 and not tp2_hit and high >= trade_tp2
    tp3_triggered = trade_active and trade_dir == 1 and not tp3_hit and high >= trade_tp3
    sl_triggered  = trade_active and trade_dir == 1 and low <= trade_sl

    tp1_triggered := tp1_triggered or (trade_active and trade_dir == -1 and not tp1_hit and low <= trade_tp1)
    tp2_triggered := tp2_triggered or (trade_active and trade_dir == -1 and not tp2_hit and low <= trade_tp2)
    tp3_triggered := tp3_triggered or (trade_active and trade_dir == -1 and not tp3_hit and low <= trade_tp3)
    sl_triggered  := sl_triggered  or (trade_active and trade_dir == -1 and high >= trade_sl)

    // ── Handle Partial Target Hits
    if tp1_triggered and not tp1_hit
        tp1_hit := true
        if show_labels
            label.new(bar_index, trade_tp1, "🎯 TP1 HIT (40%)", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(#22c55e, 10), textcolor=color.white, size=size.small)
        // Module 15 Break-Even rules
        if enable_be
            trade_sl := trade_entry
            if not na(ln_sl)
                line.set_y1(ln_sl, trade_sl)
                line.set_y2(ln_sl, trade_sl)

    if tp2_triggered and not tp2_hit
        tp2_hit := true
        if show_labels
            label.new(bar_index, trade_tp2, "🎯 TP2 HIT (40%)", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(#22c55e, 10), textcolor=color.white, size=size.small)

    // ── Check Overall Trade Exit
    exit_triggered = sl_triggered or tp3_triggered

    if exit_triggered and trade_active
        float r_gain = 0.0
        string result_txt = ""
        color  result_col = color.gray
        float  result_y   = trade_entry

        if sl_triggered
            if tp2_hit
                r_gain     := 1.2  // 0.4*1R + 0.4*2R + 0.2*BE = 1.2R
                result_txt := "❌ SL HIT (Profit +1.2R)"
                result_col := #3b82f6
            else if tp1_hit
                r_gain     := 0.4  // 0.4*1R + 0.6*BE = 0.4R
                result_txt := "❌ BE HIT (Profit +0.4R)"
                result_col := #3b82f6
            else
                r_gain     := -1.0 // Full 1R loss
                result_txt := "❌ SL HIT (-1.0R)"
                result_col := #ef4444
            result_y := trade_sl
        else if tp3_triggered
            tp3_hit    := true
            r_gain     := 1.8  // 0.4*1R + 0.4*2R + 0.2*3R = 1.8R
            result_txt := "🏆 ALL TPs HIT (+1.8R)"
            result_col := #22c55e
            result_y   := trade_tp3

        // Module 18: Update performance metrics
        total_trades_count := total_trades_count + 1
        if r_gain > 0
            wins_count := wins_count + 1
        net_r_gained := net_r_gained + r_gain
        if net_r_gained > peak_net_r
            peak_net_r := net_r_gained
        float current_dd = peak_net_r - net_r_gained
        if current_dd > max_r_drawdown
            max_r_drawdown := current_dd

        // Update trade journal logs by session and pattern type
        if trade_sess == "LONDON"
            london_trades := london_trades + 1
            if r_gain > 0
                london_wins := london_wins + 1
        else if trade_sess == "NEW YORK"
            ny_trades := ny_trades + 1
            if r_gain > 0
                ny_wins := ny_wins + 1
        else if trade_sess == "ASIA"
            asia_trades := asia_trades + 1
            if r_gain > 0
                asia_wins := asia_wins + 1

        if trade_pattern == "ICT REVERSAL"
            pat_rev_trades := pat_rev_trades + 1
            if r_gain > 0
                pat_rev_wins := pat_rev_wins + 1
        else if trade_pattern == "TREND CONTINUATION"
            pat_cont_trades := pat_cont_trades + 1
            if r_gain > 0
                pat_cont_wins := pat_cont_wins + 1
        else if trade_pattern == "RANGE BREAKOUT" or trade_pattern == "MOMENTUM CONTINUE"
            pat_brk_trades := pat_brk_trades + 1
            if r_gain > 0
                pat_brk_wins := pat_brk_wins + 1

        // T018: Update score band statistics
        if trade_score >= 90
            band_90_trades := band_90_trades + 1
            if r_gain > 0
                band_90_wins := band_90_wins + 1
        else if trade_score >= 80
            band_80_trades := band_80_trades + 1
            if r_gain > 0
                band_80_wins := band_80_wins + 1
        else if trade_score >= 70
            band_70_trades := band_70_trades + 1
            if r_gain > 0
                band_70_wins := band_70_wins + 1
        else if trade_score >= 60
            band_60_trades := band_60_trades + 1
            if r_gain > 0
                band_60_wins := band_60_wins + 1

        if show_labels
            label.new(bar_index, result_y, result_txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(result_col, 10), textcolor=color.white, size=size.small)

        // Delete drawings
        if not na(ln_entry)
            line.delete(ln_entry)
            ln_entry := na
        if not na(ln_sl)
            line.delete(ln_sl)
            ln_sl := na
        if not na(ln_tp1)
            line.delete(ln_tp1)
            ln_tp1 := na
        if not na(ln_tp2)
            line.delete(ln_tp2)
            ln_tp2 := na
        if not na(ln_tp3)
            line.delete(ln_tp3)
            ln_tp3 := na
        if not na(lbl_entry)
            label.delete(lbl_entry)
            lbl_entry := na
        if not na(lbl_sl)
            label.delete(lbl_sl)
            lbl_sl := na
        if not na(lbl_tp1)
            label.delete(lbl_tp1)
            lbl_tp1 := na
        if not na(lbl_tp2)
            label.delete(lbl_tp2)
            lbl_tp2 := na
        if not na(lbl_tp3)
            label.delete(lbl_tp3)
            lbl_tp3 := na
        if not na(lbl_status)
            label.delete(lbl_status)
            lbl_status := na

        // Reset state variables
        trade_entry := na
        trade_sl    := na
        trade_tp1   := na
        trade_tp2   := na
        trade_tp3   := na
        tp1_hit     := false
        tp2_hit     := false
        tp3_hit     := false
        trade_dir   := 0
        trade_bar   := na
        trade_lot   := na

    // ── On New Signal: Open trade, draw lines + labels
    if (buy_signal or sell_signal) and trade_dir == 0
        e_px  = close
        float sl_px = na
        if sl_mode == "Structure Pivot"
            sl_px := buy_signal ? pl1 : ph1
        if na(sl_px) or sl_px <= 0.0
            sl_dist = atr_v * sl_atr_mult
            sl_px  := buy_signal ? e_px - sl_dist : e_px + sl_dist
            
        sl_dist_act = math.abs(e_px - sl_px)
        tp1_px  = buy_signal ? e_px + sl_dist_act * tp1_rr : e_px - sl_dist_act * tp1_rr
        tp2_px  = buy_signal ? e_px + sl_dist_act * tp2_rr : e_px - sl_dist_act * tp2_rr
        tp3_px  = buy_signal ? e_px + sl_dist_act * tp3_rr : e_px - sl_dist_act * tp3_rr

        // Sizing calculation
        lot_size = (acct_size * (risk_pct / 100.0)) / (sl_dist_act * syminfo.pointvalue)
        lot_size := math.max(0.01, math.round(lot_size * 100.0) / 100.0)

        trade_entry   := e_px
        trade_sl      := sl_px
        trade_tp1     := tp1_px
        trade_tp2     := tp2_px
        trade_tp3     := tp3_px
        tp1_hit       := false
        tp2_hit       := false
        tp3_hit       := false
        trade_dir     := buy_signal ? 1 : -1
        trade_bar     := bar_index
        trade_score   := dec_score
        trade_grade   := dec_grade
        trade_lot     := lot_size
        trade_pattern := setup_pattern
        trade_sess    := act_sess

        if show_lines
            if not na(ln_entry)
                line.delete(ln_entry)
                ln_entry := na
            if not na(ln_sl)
                line.delete(ln_sl)
                ln_sl := na
            if not na(ln_tp1)
                line.delete(ln_tp1)
                ln_tp1 := na
            if not na(ln_tp2)
                line.delete(ln_tp2)
                ln_tp2 := na
            if not na(ln_tp3)
                line.delete(ln_tp3)
                ln_tp3 := na

            ln_entry := line.new(bar_index, e_px,  bar_index + 1, e_px, color=#3b82f6, width=2, style=line.style_solid,  extend=extend.right)
            ln_sl    := line.new(bar_index, sl_px, bar_index + 1, sl_px, color=#ef4444, width=1, style=line.style_dashed, extend=extend.right)
            ln_tp1   := line.new(bar_index, tp1_px, bar_index + 1, tp1_px, color=#22c55e, width=1, style=line.style_dotted, extend=extend.right)
            ln_tp2   := line.new(bar_index, tp2_px, bar_index + 1, tp2_px, color=#22c55e, width=1, style=line.style_dashed, extend=extend.right)
            ln_tp3   := line.new(bar_index, tp3_px, bar_index + 1, tp3_px, color=#10b981, width=2, style=line.style_solid,  extend=extend.right)

        if show_labels
            if not na(lbl_entry)
                label.delete(lbl_entry)
                lbl_entry := na
            if not na(lbl_sl)
                label.delete(lbl_sl)
                lbl_sl := na
            if not na(lbl_tp1)
                label.delete(lbl_tp1)
                lbl_tp1 := na
            if not na(lbl_tp2)
                label.delete(lbl_tp2)
                lbl_tp2 := na
            if not na(lbl_tp3)
                label.delete(lbl_tp3)
                lbl_tp3 := na

            e_str   = str.tostring(e_px,  "#.####")
            sl_str  = str.tostring(sl_px, "#.####")
            tp1_str = str.tostring(tp1_px, "#.####")
            tp2_str = str.tostring(tp2_px, "#.####")
            tp3_str = str.tostring(tp3_px, "#.####")
            sc_str  = str.tostring(dec_score) + " [" + dec_grade + "]"
            lt_str  = str.tostring(lot_size, "#.##")

            dir_txt   = buy_signal ? "▲ BUY" : "▼ SELL"
            entry_txt = dir_txt + "  " + syminfo.ticker + "\nPattern: " + setup_pattern + "\nEntry:   " + e_str + "\nLots:    " + lt_str + "\nSL:      " + sl_str + "\nTP1:     " + tp1_str + "\nTP2:     " + tp2_str + "\nTP3:     " + tp3_str + "\nScore:   " + sc_str
            lbl_entry := label.new(bar_index, e_px, entry_txt, xloc=xloc.bar_index, yloc=yloc.price, style=buy_signal ? label.style_label_up : label.style_label_down, color=color.new(buy_signal ? #22c55e : #ef4444, 15), textcolor=color.white, size=size.small)
            lbl_sl := label.new(bar_index, sl_px, "⛔ SL  " + sl_str, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_right, color=color.new(#ef4444, 20), textcolor=color.white, size=size.tiny)
            lbl_tp1 := label.new(bar_index, tp1_px, "🎯 TP1  " + tp1_str, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_right, color=color.new(#22c55e, 20), textcolor=color.white, size=size.tiny)
            lbl_tp2 := label.new(bar_index, tp2_px, "🎯 TP2  " + tp2_str, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_right, color=color.new(#22c55e, 20), textcolor=color.white, size=size.tiny)
            lbl_tp3 := label.new(bar_index, tp3_px, "🎯 TP3  " + tp3_str, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_right, color=color.new(#10b981, 20), textcolor=color.white, size=size.tiny)

    // ── Module 16: Structure Visualization Engine
    if show_smc_viz
        // 1. HH/HL/LH/LL Labels (Lagging pivots)
        if show_pivots and not na(swing_hi)
            string ph_text = ph1 > ph2 ? "HH" : "LH"
            label.new(bar_index - 5, swing_hi, ph_text, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.black, 100), textcolor=color.new(color.yellow, 20), size=size.tiny)
                
        if show_pivots and not na(swing_lo)
            string pl_text = pl1 > pl2 ? "HL" : "LL"
            label.new(bar_index - 5, swing_lo, pl_text, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(color.black, 100), textcolor=color.new(color.yellow, 20), size=size.tiny)

        // 2. BOS & CHoCH Breakout Lines & Labels
        var string last_trend = "NEUTRAL"
        if not na(ph1) and close > ph1
            is_bos = (last_trend == "BULLISH")
            lbl_text = is_bos ? "BOS ↑" : "CHoCH ↑"
            lbl_color = is_bos ? color.new(#22c55e, 20) : color.new(#3b82f6, 20)
            if (is_bos and show_bos) or (not is_bos and show_choch)
                line.new(ph1_bar, ph1, bar_index, ph1, color=lbl_color, style=line.style_dashed, width=1)
                label.new(math.round((ph1_bar + bar_index)/2), ph1, lbl_text, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.black, 100), textcolor=lbl_color, size=size.small)
            last_trend := "BULLISH"
            ph1 := na
            
        if not na(pl1) and close < pl1
            is_bos = (last_trend == "BEARISH")
            lbl_text = is_bos ? "BOS ↓" : "CHoCH ↓"
            lbl_color = is_bos ? color.new(#ef4444, 20) : color.new(#a855f7, 20)
            if (is_bos and show_bos) or (not is_bos and show_choch)
                line.new(pl1_bar, pl1, bar_index, pl1, color=lbl_color, style=line.style_dashed, width=1)
                label.new(math.round((pl1_bar + bar_index)/2), pl1, lbl_text, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(color.black, 100), textcolor=lbl_color, size=size.small)
            last_trend := "BEARISH"
            pl1 := na

        // 3. FVG Imbalance Boxes
        if show_fvgs and fvg_active
            fvg_top = bull_fvg_v ? low : low[2]
            fvg_bot = bull_fvg_v ? high[2] : high
            box.new(bar_index - 2, fvg_top, bar_index + 8, fvg_bot, bgcolor=bull_fvg_v ? color.new(#22c55e, 90) : color.new(#ef4444, 90), border_color=bull_fvg_v ? color.new(#22c55e, 70) : color.new(#ef4444, 70), border_style=line.style_solid)

        // 4. Order Block Zones
        if show_obs and ob_active
            box.new(bar_index - 1, high[1], bar_index + 15, low[1], bgcolor=bull_ob_v ? color.new(#3b82f6, 92) : color.new(#a855f7, 92), border_color=bull_ob_v ? color.new(#3b82f6, 75) : color.new(#a855f7, 75), text=bull_ob_v ? "Bull OB" : "Bear OB", text_color=color.white, text_size=size.tiny)

        // 5. Liquidity Sweep Markers
        if show_sweeps and liq_active
            if bull_sweep_v and not bull_sweep_v[1]
                label.new(bar_index, low, "SSL Swept ✖", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_up, color=color.new(color.black, 100), textcolor=#22c55e, size=size.tiny)
            if bear_sweep_v and not bear_sweep_v[1]
                label.new(bar_index, high, "BSL Swept ✖", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_down, color=color.new(color.black, 100), textcolor=#ef4444, size=size.tiny)

// ── Volume Profile & Time Benchmark Drawings (T005, T011, T013, T024 GC)
var line line_poc = na
var line line_vah = na
var line line_val = na
var label lbl_poc = na
var label lbl_vah = na
var label lbl_val = na

var line line_asia_hi  = na
var line line_asia_lo  = na
var line line_midnight = na

if (show_session_vp or show_vprof) and barstate.islast
    if not na(line_poc)
        line.delete(line_poc)
    if not na(line_vah)
        line.delete(line_vah)
    if not na(line_val)
        line.delete(line_val)
    if not na(lbl_poc)
        label.delete(lbl_poc)
    if not na(lbl_vah)
        label.delete(lbl_vah)
    if not na(lbl_val)
        label.delete(lbl_val)
        
    start_b = math.max(0, day_start_bar)
    line_poc := line.new(start_b, dev_poc, bar_index, dev_poc, color=color.new(#a855f7, 20), width=2, style=line.style_solid)
    line_vah := line.new(start_b, dev_vah, bar_index, dev_vah, color=color.new(#ef4444, 40), width=1, style=line.style_dashed)
    line_val := line.new(start_b, dev_val, bar_index, dev_val, color=color.new(#22c55e, 40), width=1, style=line.style_dashed)
    
    lbl_poc := label.new(bar_index, dev_poc, "POC " + str.tostring(dev_poc, "#.##"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 100), textcolor=#a855f7, size=size.tiny)
    lbl_vah := label.new(bar_index, dev_vah, "VAH " + str.tostring(dev_vah, "#.##"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 100), textcolor=#ef4444, size=size.tiny)
    lbl_val := label.new(bar_index, dev_val, "VAL " + str.tostring(dev_val, "#.##"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 100), textcolor=#22c55e, size=size.tiny)

// Draw Asian Range reference lines
if show_asian_range and not in_asia_session and not na(asia_range_hi) and not na(asia_range_lo) and barstate.islast
    if not na(line_asia_hi)
        line.delete(line_asia_hi)
    if not na(line_asia_lo)
        line.delete(line_asia_lo)
    a_start = math.max(0, nz(asia_start_idx, day_start_bar))
    line_asia_hi := line.new(a_start, asia_range_hi, bar_index, asia_range_hi, color=color.new(#f59e0b, 40), style=line.style_dotted, width=1)
    line_asia_lo := line.new(a_start, asia_range_lo, bar_index, asia_range_lo, color=color.new(#3b82f6, 40), style=line.style_dotted, width=1)

// Draw New York Midnight Open Benchmark
if show_midnight_open and not na(ny_midnight_open) and barstate.islast
    if not na(line_midnight)
        line.delete(line_midnight)
    start_b = math.max(0, day_start_bar)
    line_midnight := line.new(start_b, ny_midnight_open, bar_index + 10, ny_midnight_open, color=color.new(#94a3b8, 30), style=line.style_dashed, width=1)

// ── Live Labels: Fixed Anchor with Dynamic Text Updates
if trade_dir != 0 and not na(trade_entry) and show_labels
    dur_bars   = bar_index - trade_bar
    cur_pnl    = trade_dir == 1 ? close - trade_entry : trade_entry - close
    pnl_str    = cur_pnl >= 0 ? "+" + str.tostring(cur_pnl, "#.####") : str.tostring(cur_pnl, "#.####")
    dir_str    = trade_dir == 1 ? "▲ BUY ACTIVE" : "▼ SELL ACTIVE"
    sc_lbl     = str.tostring(trade_score) + " [" + trade_grade + "]"
    dur_str    = str.tostring(dur_bars)
    
    // Status text showing active target achievements
    status_txt = dir_str + "  |  Score: " + sc_lbl + "\nPnL: " + pnl_str + "  |  Bars: " + dur_str + "\nTargets: TP1 " + (tp1_hit ? "✓" : "✗") + " | TP2 " + (tp2_hit ? "✓" : "✗") + " | TP3 " + (tp3_hit ? "✓" : "✗")
    status_col = cur_pnl >= 0 ? color.new(#22c55e, 20) : color.new(#ef4444, 20)

    // Status label — anchored at opening candle, text updates dynamically
    if na(lbl_status)
        lbl_status := label.new(trade_bar, trade_entry, status_txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_right, color=status_col, textcolor=color.white, size=size.small)
    else
        label.set_text(lbl_status, status_txt)
        label.set_color(lbl_status, status_col)

    // SL label — anchored at opening candle, text updates dynamically
    if not na(lbl_sl) and not na(trade_sl)
        label.set_text(lbl_sl, (trade_sl == trade_entry ? "⛔ SL (BE)  " : "⛔ SL  ") + str.tostring(trade_sl, "#.####"))
        label.set_y(lbl_sl, trade_sl)

    // TP1 label — anchored at opening candle, text updates dynamically
    if not na(lbl_tp1) and not na(trade_tp1)
        label.set_text(lbl_tp1, "🎯 TP1  " + str.tostring(trade_tp1, "#.####") + (tp1_hit ? " (Hit)" : ""))

    // TP2 label — anchored at opening candle, text updates dynamically
    if not na(lbl_tp2) and not na(trade_tp2)
        label.set_text(lbl_tp2, "🎯 TP2  " + str.tostring(trade_tp2, "#.####") + (tp2_hit ? " (Hit)" : ""))

    // TP3 label — anchored at opening candle, text updates dynamically
    if not na(lbl_tp3) and not na(trade_tp3)
        label.set_text(lbl_tp3, "🎯 TP3  " + str.tostring(trade_tp3, "#.####") + (tp3_hit ? " (Hit)" : ""))

// ============================================================
// ── MODULE 7: DASHBOARD PANEL
// ── 4-column side-by-side HUD table overlay with all engine readings.
// ============================================================
tbl_pos = hud_pos == "Top Right" ? position.top_right : hud_pos == "Top Left" ? position.top_left : hud_pos == "Bottom Right" ? position.bottom_right : position.bottom_left

var table hud_compact = na
var table hud = na

if barstate.islast
    if show_hud and hud_mode != "Hidden"
        if str.contains(hud_mode, "Compact")
            if not na(hud)
                table.delete(hud)
                hud := na
            if na(hud_compact)
                hud_compact := table.new(tbl_pos, 4, 11, bgcolor=hud_bg, border_color=color.new(#334155, 0), border_width=1, frame_color=color.new(#a855f7, 0), frame_width=1)
                table.merge_cells(hud_compact, 0, 0, 1, 0)
                table.merge_cells(hud_compact, 2, 0, 3, 0)
                table.merge_cells(hud_compact, 0, 8, 3, 8)
        else if hud_mode == "Full (34 Rows)"
            if not na(hud_compact)
                table.delete(hud_compact)
                hud_compact := na
            if na(hud)
                hud := table.new(tbl_pos, 4, 34, bgcolor=hud_bg, border_color=color.new(#334155, 0), border_width=1, frame_color=color.new(#a855f7, 0), frame_width=1)
                // Merge Top Headers
                table.merge_cells(hud, 0, 0, 1, 0)
                table.merge_cells(hud, 2, 0, 3, 0)
                
                // Merge Left Section Headers
                table.merge_cells(hud, 0, 1, 1, 1)   // DECISION SCORE
                table.merge_cells(hud, 0, 7, 1, 7)   // SCORE BREAKDOWN
                table.merge_cells(hud, 0, 19, 1, 19) // MOMENTUM
                table.merge_cells(hud, 0, 25, 1, 25) // MARKET REGIME
                table.merge_cells(hud, 0, 30, 1, 30) // VOLATILITY
                
                // Merge Right Section Headers
                table.merge_cells(hud, 2, 1, 3, 1)   // ICT SMART MONEY
                table.merge_cells(hud, 2, 7, 3, 7)   // MULTI-TIMEFRAME
                table.merge_cells(hud, 2, 12, 3, 12) // SESSION & FLOW
                table.merge_cells(hud, 2, 17, 3, 17) // PERFORMANCE
                table.merge_cells(hud, 2, 24, 3, 24) // JOURNAL BY SESSION
                table.merge_cells(hud, 2, 29, 3, 29) // JOURNAL BY PATTERN
    else
        if not na(hud)
            table.delete(hud)
            hud := na
        if not na(hud_compact)
            table.delete(hud_compact)
            hud_compact := na

if show_hud and hud_mode != "Hidden" and barstate.islast
    // Color palette
    c_green  = #22c55e
    c_red    = #ef4444
    c_yellow = #eab308
    c_blue   = #3b82f6
    c_purple = #a855f7
    c_hdr    = color.new(#1e1b4b, 0)
    c_sub    = color.new(#1a1f35, 0)
    c_txt    = hud_txt

    sc_col = dec_score >= 90 ? c_green : dec_score >= 80 ? c_blue : dec_score >= 70 ? c_yellow : c_red
    sig_str = buy_signal ? "▲ BUY" : sell_signal ? "▼ SELL" : "WATCHING"
    sig_col = buy_signal ? c_green : sell_signal ? c_red : c_yellow
    reg_col = str.contains(regime_lbl, "BULL") ? c_green : str.contains(regime_lbl, "BEAR") ? c_red : regime_lbl == "HIGH_VOLATILITY" ? c_red : regime_lbl == "TRANSITION" ? c_yellow : color.gray
    mtf_align_col = mtf_status == "BULLISH" ? c_green : mtf_status == "BEARISH" ? c_red : c_yellow
    sess_col      = act_sess == "OFF-HOURS" ? c_red : act_sess == "ASIA" ? c_yellow : c_green
    news_col      = news_active ? c_red : c_green

    // Note: Execution targets and lot sizing are calculated at global scope

    if str.contains(hud_mode, "Compact")
        // ── COMPACT DASHBOARD (Clean 5 Rows)
        table.cell(hud_compact, 0, 0, "⚡ ADAPTIVE ICT", text_color=c_purple, text_size=size.small, bgcolor=c_hdr, text_halign="center")
        table.cell(hud_compact, 2, 0, mode == "Momentum Scalper" ? "MOMENTUM" : "ICT SNIPER", text_color=color.new(c_purple, 40), text_size=size.tiny, bgcolor=c_hdr, text_halign="center")

        table.cell(hud_compact, 0, 1, "  Score", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 1, 1, str.tostring(dec_score) + " [" + dec_grade + "]  ", text_color=sc_col, text_size=size.tiny, text_halign="right")
        table.cell(hud_compact, 2, 1, "  Signal", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 3, 1, sig_str + "  ", text_color=sig_col, text_size=size.tiny, text_halign="right")

        table.cell(hud_compact, 0, 2, "  Pattern", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 1, 2, setup_pattern + "  ", text_color=c_purple, text_size=size.tiny, text_halign="right")
        table.cell(hud_compact, 2, 2, "  Lots", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 3, 2, str.tostring(curr_lot_size, "#.##") + " Lots  ", text_color=c_txt, text_size=size.tiny, text_halign="right")

        table.cell(hud_compact, 0, 3, "  Regime", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 1, 3, regime_lbl + "  ", text_color=reg_col, text_size=size.tiny, text_halign="right")
        table.cell(hud_compact, 2, 3, "  News Gate", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 3, 3, news_lbl + "  ", text_color=news_col, text_size=size.tiny, text_halign="right")

        table.cell(hud_compact, 0, 4, "  Session", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 1, 4, act_sess + "  ", text_color=sess_col, text_size=size.tiny, text_halign="right")
        table.cell(hud_compact, 2, 4, "  Confluence", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 3, 4, mtf_status + "  ", text_color=mtf_align_col, text_size=size.tiny, text_halign="right")

        // Rows 5-7: Institutional Benchmarks Telemetry (T015, T023)
        table.cell(hud_compact, 0, 5, "  Dev POC", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 1, 5, (not na(dev_poc) ? str.tostring(dev_poc, "#.##") : "--") + "  ", text_color=c_purple, text_size=size.tiny, text_halign="right")
        table.cell(hud_compact, 2, 5, "  vPOC Active", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 3, 5, str.tostring(array.size(virgin_pocs)) + " Active  ", text_color=array.size(virgin_pocs) > 0 ? c_yellow : color.gray, text_size=size.tiny, text_halign="right")

        table.cell(hud_compact, 0, 6, "  Asian Range", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 1, 6, (not na(asia_range_hi) ? str.tostring(asia_range_hi, "#.#") + "-" + str.tostring(asia_range_lo, "#.#") : "--") + "  ", text_color=c_blue, text_size=size.tiny, text_halign="right")
        table.cell(hud_compact, 2, 6, "  Judas Sweep", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 3, 6, (judas_bull_sweep ? "LOW SWEPT" : judas_bear_sweep ? "HIGH SWEPT" : "NONE") + "  ", text_color=judas_swing_detected ? c_green : color.gray, text_size=size.tiny, text_halign="right")

        table.cell(hud_compact, 0, 7, "  True Open", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 1, 7, (not na(ny_midnight_open) ? str.tostring(ny_midnight_open, "#.##") : "--") + "  ", text_color=c_txt, text_size=size.tiny, text_halign="right")
        table.cell(hud_compact, 2, 7, "  SMT Radar", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 3, 7, (smt_bull_div ? "BULL DIV" : smt_bear_div ? "BEAR DIV" : "ALIGNED") + "  ", text_color=(smt_bull_div or smt_bear_div) ? c_blue : color.gray, text_size=size.tiny, text_halign="right")

        // Rows 8-10: Dedicated Execution Targets (TP1, TP2, TP3, SL)
        table.cell(hud_compact, 0, 8, "🎯 EXECUTION TARGETS (TP / SL)", text_color=color.white, text_size=size.tiny, bgcolor=c_sub, text_halign="center")

        table.cell(hud_compact, 0, 9, "  TP1 (1.2R)", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 1, 9, tp1_txt + "  ", text_color=c_green, text_size=size.tiny, text_halign="right")
        table.cell(hud_compact, 2, 9, "  TP2 (2.5R)", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 3, 9, tp2_txt + "  ", text_color=c_green, text_size=size.tiny, text_halign="right")

        table.cell(hud_compact, 0, 10, "  TP3 (4.0R)", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 1, 10, tp3_txt + "  ", text_color=#10b981, text_size=size.tiny, text_halign="right")
        table.cell(hud_compact, 2, 10, "  Stop Loss", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud_compact, 3, 10, sl_txt + "  ", text_color=c_red, text_size=size.tiny, text_halign="right")

    else if hud_mode == "Full (34 Rows)"
        // ── FULL TELEMETRY DASHBOARD (34 Rows)
        // ── HEADER (Row 0)
        table.cell(hud, 0, 0, "⚡ ADAPTIVE ICT — DECISION ENGINE", text_color=c_purple, text_size=size.small, bgcolor=c_hdr, text_halign="center")
        table.cell(hud, 2, 0, mode == "Momentum Scalper" ? "MOMENTUM MODE" : "ICT SNIPER MODE", text_color=color.new(c_purple, 40), text_size=size.tiny, bgcolor=c_hdr, text_halign="center")

        // ── LEFT COLUMN SECTIONS ──

        // DECISION SCORE (Rows 1-6)
        table.cell(hud, 0, 1, "  DECISION SCORE", text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        table.cell(hud, 0, 2, "  Score",  text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 2, str.tostring(dec_score) + " / 100  ", text_color=sc_col, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 3, "  Grade",  text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 3, dec_grade + "  ", text_color=sc_col, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 4, "  Signal", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 4, sig_str + "  ", text_color=sig_col, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 5, "  Pattern", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 5, setup_pattern + "  ", text_color=c_purple, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 6, "  Sized Lots", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 6, str.tostring(curr_lot_size, "#.##") + " Lots  ", text_color=c_txt, text_size=size.tiny, text_halign="right")

        // SCORE BREAKDOWN (AI) (Rows 7-18)
        table.cell(hud, 0, 7, "  SCORE BREAKDOWN (AI)", text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        table.cell(hud, 0, 8, "  Momentum Weight",       text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 8, "+" + str.tostring(c_mom, "#.1") + "  ", text_color=c_mom > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 9, "  Regime Weight",         text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 9, "+" + str.tostring(c_reg, "#.1") + "  ", text_color=c_reg > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 10, "  Volatility Weight",     text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 10, "+" + str.tostring(c_vol, "#.1") + "  ", text_color=c_vol > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 11, "  Structure Weight",      text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 11, "+" + str.tostring(c_struct, "#.1") + "  ", text_color=c_struct > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 12, "  Liquidity Weight",      text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 12, "+" + str.tostring(c_liq, "#.1") + "  ", text_color=c_liq > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 13, "  FVG Imbalance Weight",  text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 13, "+" + str.tostring(c_fvg, "#.1") + "  ", text_color=c_fvg > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 14, "  Order Block Weight",    text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 14, "+" + str.tostring(c_ob, "#.1") + "  ", text_color=c_ob > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 15, "  Premium/Discount Wt",   text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 15, "+" + str.tostring(c_pd, "#.1") + "  ", text_color=c_pd > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 16, "  HTF / MTF Weight",      text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 16, "+" + str.tostring(c_mtf, "#.1") + "  ", text_color=c_mtf > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 17, "  Order Flow Weight",     text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 17, "+" + str.tostring(c_of, "#.1") + "  ", text_color=c_of > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 18, "  Session Filter Weight",  text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 18, "+" + str.tostring(c_sess, "#.1") + "  ", text_color=c_sess > 0 ? c_green : color.gray, text_size=size.tiny, text_halign="right")

        // MOMENTUM (Rows 19-24)
        table.cell(hud, 0, 19, "  MOMENTUM", text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        m_col = mom_s >= 75 ? c_green : mom_s >= 50 ? c_yellow : c_red
        table.cell(hud, 0, 20, "  Score",       text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 20, str.tostring(mom_s) + " / 100  ", text_color=m_col, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 21, "  Velocity",    text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 21, vel_lbl + "  ", text_color=vel_lbl == "Strong" ? c_green : vel_lbl == "Moderate" ? c_yellow : c_red, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 22, "  Acceleration",text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 22, accel_lbl + "  ", text_color=accel_lbl == "Increasing" ? c_green : accel_lbl == "Weakening" ? c_red : c_yellow, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 23, "  Candle Exp.", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 23, str.tostring(exp_ratio, "#.##") + "x  ", text_color=exp_ratio >= exp_thresh ? c_green : c_yellow, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 24, "  Volume",     text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 24, vol_lbl + " (" + str.tostring(vol_ratio_v, "#.#") + "x)  ", text_color=vol_ratio_v > 1.4 ? c_green : c_yellow, text_size=size.tiny, text_halign="right")

        // MARKET REGIME (Rows 25-29)
        table.cell(hud, 0, 25, "  MARKET REGIME", text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        table.cell(hud, 0, 26, "  Regime",     text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 26, regime_lbl + "  ", text_color=reg_col, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 27, "  Confidence", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 27, str.tostring(regime_conf) + "%  ", text_color=regime_conf >= 75 ? c_green : c_yellow, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 28, "  ADX",        text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 28, str.tostring(adx_v, "#.#") + "  ", text_color=adx_v > adx_trend ? c_green : c_yellow, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 29, "  HTF Bias",   text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 29, (ema_bias_v == 1 ? "BULLISH" : "BEARISH") + "  ", text_color=ema_bias_v == 1 ? c_green : c_red, text_size=size.tiny, text_halign="right")

        // VOLATILITY (Rows 30-33)
        table.cell(hud, 0, 30, "  VOLATILITY", text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        v_col = vol_state == "HIGH" ? c_green : vol_state == "NORMAL" ? c_blue : vol_state == "EXTREME" ? c_red : c_yellow
        table.cell(hud, 0, 31, "  State",     text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 31, vol_state + "  ", text_color=v_col, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 32, "  Condition", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 32, vol_cond + "  ",  text_color=v_col, text_size=size.tiny, text_halign="right")
        table.cell(hud, 0, 33, "  ATR %",    text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 1, 33, str.tostring(atr_pct_v * 100, "#.##") + "%  ", text_color=c_txt, text_size=size.tiny, text_halign="right")

        // ── RIGHT COLUMN SECTIONS ──

        // ICT SMART MONEY (Rows 1-6)
        table.cell(hud, 2, 1, "  ICT SMART MONEY", text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        st_col = struct_lbl == "BULLISH" or struct_lbl == "CHOCH BULL" ? c_green : struct_lbl == "BEARISH" or struct_lbl == "CHOCH BEAR" ? c_red : color.gray
        table.cell(hud, 2, 2, "  Structure",  text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 2, struct_lbl + "  ", text_color=st_col, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 3, "  Liquidity",  text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 3, (liq_active ? liq_lbl : "None") + "  ", text_color=liq_active ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 4, "  FVG",        text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 4, (fvg_active ? fvg_lbl : "None") + "  ", text_color=fvg_active ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 5, "  Order Block",text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 5, (ob_active ? ob_lbl : "None") + "  ",   text_color=ob_active ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        pd_col = pd_zone == "DISCOUNT" ? c_green : pd_zone == "PREMIUM" ? c_red : c_yellow
        table.cell(hud, 2, 6, "  Price Zone", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 6, pd_zone + " (" + str.tostring(pd_pct, "#") + "%)  ", text_color=pd_col, text_size=size.tiny, text_halign="right")

        // MULTI-TIMEFRAME (Rows 7-11)
        table.cell(hud, 2, 7, "  MULTI-TIMEFRAME", text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        table.cell(hud, 2, 8, "  4H Bias",        text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 8, (htf1_bias == 1 ? "BULLISH" : "BEARISH") + "  ", text_color=htf1_bias == 1 ? c_green : c_red, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 9, "  1H Bias",        text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 9, (htf2_bias == 1 ? "BULLISH" : "BEARISH") + "  ", text_color=htf2_bias == 1 ? c_green : c_red, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 10, "  15M Bias",       text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 10, (htf3_bias == 1 ? "BULLISH" : "BEARISH") + "  ", text_color=htf3_bias == 1 ? c_green : c_red, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 11, "  Confluence",     text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 11, mtf_status + "  ",       text_color=mtf_align_col, text_size=size.tiny, text_halign="right")

        // SESSION FILTER & ORDER FLOW (Rows 12-16)
        table.cell(hud, 2, 12, "  SESSION & FLOW",  text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        table.cell(hud, 2, 13, "  Active Session", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 13, act_sess + "  ",         text_color=sess_col, text_size=size.tiny, text_halign="right")
        d_col = delta_pct_v > 15.0 ? c_green : delta_pct_v < -15.0 ? c_red : c_yellow
        table.cell(hud, 2, 14, "  Volume Delta",   text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 14, str.tostring(delta_pct_v, "#.##") + "%  ", text_color=d_col, text_size=size.tiny, text_halign="right")
        div_col = of_lbl == "Neutral" ? c_txt : of_lbl == "Bullish Div" ? c_green : c_red
        table.cell(hud, 2, 15, "  CVD Divergence", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 15, of_lbl + "  ",           text_color=div_col, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 16, "  News Gate",       text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 16, news_lbl + "  ",          text_color=news_col, text_size=size.tiny, text_halign="right")

        // PERFORMANCE ANALYTICS (Rows 17-23)
        table.cell(hud, 2, 17, "  PERFORMANCE & DETAILS", text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        win_rate = total_trades_count > 0 ? (float(wins_count) / float(total_trades_count)) * 100.0 : 0.0
        table.cell(hud, 2, 18, "  Total Trades",           text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 18, str.tostring(total_trades_count) + "  ", text_color=c_txt, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 19, "  Win Rate",               text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 19, str.tostring(win_rate, "#.#") + "%  ", text_color=win_rate >= 50 ? c_green : c_yellow, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 20, "  Net R-Gain",             text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 20, str.tostring(net_r_gained, "#.##") + " R  ", text_color=net_r_gained >= 0 ? c_green : c_red, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 21, "  Target TP1 (1.2R)",      text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 21, tp1_txt + "  ", text_color=c_green, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 22, "  Target TP2 (2.5R)",      text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 22, tp2_txt + "  ", text_color=c_green, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 23, "  Target TP3 (4.0R)",      text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 23, tp3_txt + "  ", text_color=#10b981, text_size=size.tiny, text_halign="right")

        // JOURNAL BY SESSION (Rows 24-28)
        table.cell(hud, 2, 24, "  JOURNAL BY SESSION",     text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        lon_wr = london_trades > 0 ? (float(london_wins) / float(london_trades)) * 100.0 : 0.0
        ny_wr  = ny_trades > 0 ? (float(ny_wins) / float(ny_trades)) * 100.0 : 0.0
        as_wr  = asia_trades > 0 ? (float(asia_wins) / float(asia_trades)) * 100.0 : 0.0
        table.cell(hud, 2, 25, "  London Session",         text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 25, str.tostring(london_trades) + " (" + str.tostring(lon_wr, "#.#") + "%)  ", text_color=lon_wr >= 50 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 26, "  New York Session",       text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 26, str.tostring(ny_trades) + " (" + str.tostring(ny_wr, "#.#") + "%)  ", text_color=ny_wr >= 50 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 27, "  Asian Session",          text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 27, str.tostring(asia_trades) + " (" + str.tostring(as_wr, "#.#") + "%)  ", text_color=as_wr >= 50 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 28, "  Asian Range (00-08)",   text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 28, (not na(asia_range_hi) ? str.tostring(asia_range_hi, "#.#") + "-" + str.tostring(asia_range_lo, "#.#") : "--") + "  ", text_color=c_blue, text_size=size.tiny, text_halign="right")

        // JOURNAL BY SETUP PATTERN (Rows 29-33)
        table.cell(hud, 2, 29, "  JOURNAL BY PATTERN",     text_color=color.gray, text_size=size.tiny, bgcolor=c_sub, text_halign="left")
        rev_wr  = pat_rev_trades > 0 ? (float(pat_rev_wins) / float(pat_rev_trades)) * 100.0 : 0.0
        cont_wr = pat_cont_trades > 0 ? (float(pat_cont_wins) / float(pat_cont_trades)) * 100.0 : 0.0
        brk_wr  = pat_brk_trades > 0 ? (float(pat_brk_wins) / float(pat_brk_trades)) * 100.0 : 0.0
        table.cell(hud, 2, 30, "  ICT Reversal",           text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 30, str.tostring(pat_rev_trades) + " (" + str.tostring(rev_wr, "#.#") + "%)  ", text_color=rev_wr >= 50 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 31, "  Trend Continuation",     text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 31, str.tostring(pat_cont_trades) + " (" + str.tostring(cont_wr, "#.#") + "%)  ", text_color=cont_wr >= 50 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 32, "  Breakout Scalp",         text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 32, str.tostring(pat_brk_trades) + " (" + str.tostring(brk_wr, "#.#") + "%)  ", text_color=brk_wr >= 50 ? c_green : color.gray, text_size=size.tiny, text_halign="right")
        table.cell(hud, 2, 33, "  SMT Radar (" + smt_symbol + ")", text_color=c_txt, text_size=size.tiny, text_halign="left")
        table.cell(hud, 3, 33, (smt_bull_div ? "BULL DIV" : smt_bear_div ? "BEAR DIV" : "ALIGNED") + "  ", text_color=(smt_bull_div or smt_bear_div) ? c_blue : color.gray, text_size=size.tiny, text_halign="right")

// ============================================================
// ── ALERTS
// ============================================================
// Alert 1: High Quality BUY
alertcondition(buy_signal and dec_score >= 85,
     "⚡ High Quality BUY — AdaptiveICT",
     "AdaptiveICT: HIGH QUALITY BUY on {{ticker}} {{interval}} — Score A grade. Check dashboard for reasons.")

// Alert 2: High Quality SELL
alertcondition(sell_signal and dec_score >= 85,
     "⚡ High Quality SELL — AdaptiveICT",
     "AdaptiveICT: HIGH QUALITY SELL on {{ticker}} {{interval}} — Score A grade. Check dashboard for reasons.")

// Alert 3: Momentum Weakening
alertcondition(mom_s < 40 and mom_s[1] >= 60,
     "⚠️ Momentum Weakening — AdaptiveICT",
     "AdaptiveICT: Momentum dropped sharply on {{ticker}} {{interval}} — consider closing position.")

// Alert 4: Exit Warning — structure flips against trade
alertcondition((buy_signal[1] and struct_bias_v == -1) or (sell_signal[1] and struct_bias_v == 1),
     "🔴 Exit Warning — AdaptiveICT",
     "AdaptiveICT: Market structure flipped against open trade on {{ticker}} {{interval}} — review position.")

// Alert 5: Regime Shift Notification (T020)
reg_shifted = regime_lbl != regime_lbl[1]
alertcondition(reg_shifted,
     "🔄 Regime Shift — AdaptiveICT",
     "AdaptiveICT: Market regime changed on {{ticker}} {{interval}}. Check dashboard for updated trading conditions.")

// Alert 6: Virgin POC Mitigated (T009)
alertcondition(vpoc_touched,
     "🎯 Virgin POC Mitigated — AdaptiveICT",
     "AdaptiveICT: Virgin POC touched and mitigated on {{ticker}} {{interval}}.")

// Alert 7: Judas Swing Liquidity Sweep (T014)
alertcondition(judas_swing_detected,
     "⚡ Judas Swing Liquidity Sweep — AdaptiveICT",
     "AdaptiveICT: Judas Swing detected! Asian Range liquidity swept during London Open on {{ticker}} {{interval}}.")

// Alert 8: Value Area 80% Rule Rotation (T009)
alertcondition(va_80_rule_active and not va_80_rule_active[1],
     "📊 Value Area 80% Rule Rotation — AdaptiveICT",
     "AdaptiveICT: Market Profile 80% Rule activated! Rotation active towards developing POC on {{ticker}} {{interval}}.")

// Alert 9: Multi-Asset SMT Divergence Detected
alertcondition(smt_bull_div or smt_bear_div,
     "🛰️ SMT Divergence Detected — AdaptiveICT",
     "AdaptiveICT: Smart Money Tool (SMT) Divergence detected between primary asset and benchmark on {{ticker}} {{interval}}.")
// ── Persistent Live Execution Target Lines & Labels (Always Visible)
var line live_ln_entry = na
var line live_ln_sl    = na
var line live_ln_tp1   = na
var line live_ln_tp2   = na
var line live_ln_tp3   = na

var label live_lbl_entry = na
var label live_lbl_sl    = na
var label live_lbl_tp1   = na
var label live_lbl_tp2   = na
var label live_lbl_tp3   = na

if show_lines and barstate.islast
    if not na(live_ln_entry)
        line.delete(live_ln_entry)
    if not na(live_ln_sl)
        line.delete(live_ln_sl)
    if not na(live_ln_tp1)
        line.delete(live_ln_tp1)
    if not na(live_ln_tp2)
        line.delete(live_ln_tp2)
    if not na(live_ln_tp3)
        line.delete(live_ln_tp3)

    if not na(live_lbl_entry)
        label.delete(live_lbl_entry)
    if not na(live_lbl_sl)
        label.delete(live_lbl_sl)
    if not na(live_lbl_tp1)
        label.delete(live_lbl_tp1)
    if not na(live_lbl_tp2)
        label.delete(live_lbl_tp2)
    if not na(live_lbl_tp3)
        label.delete(live_lbl_tp3)

    live_x1 = bar_index - 8
    live_x2 = bar_index + 16

    live_ln_entry := line.new(live_x1, disp_entry, live_x2, disp_entry, color=#3b82f6, width=1, style=line.style_solid)
    live_ln_sl    := line.new(live_x1, disp_sl, live_x2, disp_sl, color=#ef4444, width=1, style=line.style_dashed)
    live_ln_tp1   := line.new(live_x1, disp_tp1, live_x2, disp_tp1, color=#22c55e, width=1, style=line.style_dotted)
    live_ln_tp2   := line.new(live_x1, disp_tp2, live_x2, disp_tp2, color=#22c55e, width=2, style=line.style_dashed)
    live_ln_tp3   := line.new(live_x1, disp_tp3, live_x2, disp_tp3, color=#10b981, width=2, style=line.style_solid)

    live_lbl_entry := label.new(live_x2, disp_entry, (trade_active ? "ENTRY " : "PROJ ENTRY ") + str.tostring(disp_entry, "#.##"), xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(#3b82f6, 10), textcolor=color.white, size=size.tiny)
    live_lbl_sl    := label.new(live_x2, disp_sl, (trade_active ? "⛔ SL " : "⛔ PROJ SL ") + sl_txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(#ef4444, 10), textcolor=color.white, size=size.tiny)
    live_lbl_tp1   := label.new(live_x2, disp_tp1, "🎯 TP1 " + tp1_txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(#22c55e, 10), textcolor=color.white, size=size.tiny)
    live_lbl_tp2   := label.new(live_x2, disp_tp2, "🎯 TP2 " + tp2_txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(#22c55e, 10), textcolor=color.white, size=size.tiny)
    live_lbl_tp3   := label.new(live_x2, disp_tp3, "🎯 TP3 " + tp3_txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(#10b981, 10), textcolor=color.white, size=size.tiny)
