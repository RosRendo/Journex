#property copyright "Copyright 2026, AdaptiveICT"
#property link      "https://www.mql5.com"
#property version   "1.00"
#property once

#include "../Core/Config.mqh"

//+------------------------------------------------------------------+
//| Visualizer class to handle chart drawings                       |
//+------------------------------------------------------------------+
class Visualizer
  {
private:
   //+------------------------------------------------------------------+
   //| Clean up visuals for a specific trade                           |
   //+------------------------------------------------------------------+
   static void CleanTradeVisuals(string signal_id)
     {
      ObjectDelete(0, "Arrow_" + signal_id);
      ObjectDelete(0, "Entry_" + signal_id);
      ObjectDelete(0, "SL_" + signal_id);
      ObjectDelete(0, "TP_" + signal_id);
     }

public:
   //+------------------------------------------------------------------+
   //| Clean up all visual drawings generated by EA                     |
   //+------------------------------------------------------------------+
   static void CleanAllVisuals()
     {
      int total_objects = ObjectsTotal(0, 0, -1);
      for(int i = total_objects - 1; i >= 0; i--)
        {
         string obj_name = ObjectName(0, i, 0, -1);
         if(StringSubstr(obj_name, 0, 3) == "SL_" || 
            StringSubstr(obj_name, 0, 3) == "TP_" || 
            StringSubstr(obj_name, 0, 6) == "Entry_" ||
            StringSubstr(obj_name, 0, 6) == "Arrow_")
           {
            ObjectDelete(0, obj_name);
           }
        }
      ChartRedraw(0);
     }

   //+------------------------------------------------------------------+
   //| Update all trade drawings and clean up closed ones               |
   //+------------------------------------------------------------------+
   static void UpdateVisuals()
     {
      if(!InpShowVisuals)
        {
         CleanAllVisuals();
         return;
        }

      // 1. Clean up old/closed positions
      int total_objects = ObjectsTotal(0, 0, -1);
      for(int i = total_objects - 1; i >= 0; i--)
        {
         string obj_name = ObjectName(0, i, 0, -1);
         if(StringSubstr(obj_name, 0, 3) == "SL_" || 
            StringSubstr(obj_name, 0, 3) == "TP_" || 
            StringSubstr(obj_name, 0, 6) == "Entry_" ||
            StringSubstr(obj_name, 0, 6) == "Arrow_")
           {
            // Extract ticket ID
            int underscore_pos = StringFind(obj_name, "_");
            if(underscore_pos > 0)
              {
               string ticket_str = StringSubstr(obj_name, underscore_pos + 1);
               ulong ticket = StringToInteger(ticket_str);
               
               // Check if position still exists
               if(ticket > 0 && !PositionSelectByTicket(ticket))
                 {
                  CleanTradeVisuals(ticket_str);
                 }
              }
           }
        }

      // 2. Draw/Update active positions
      for(int i = PositionsTotal() - 1; i >= 0; i--)
        {
         ulong ticket = PositionGetTicket(i);
         if(ticket > 0 && PositionGetInteger(POSITION_MAGIC) == InpMagic)
           {
            double entry = PositionGetDouble(POSITION_PRICE_OPEN);
            double sl = PositionGetDouble(POSITION_SL);
            double tp = PositionGetDouble(POSITION_TP);
            string type = (PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY) ? "BUY" : "SELL";
            string ticket_str = IntegerToString(ticket);

            // Draw or update SL Line
            if(sl > 0)
              {
               string sl_name = "SL_" + ticket_str;
               if(ObjectFind(0, sl_name) < 0)
                 {
                  ObjectCreate(0, sl_name, OBJ_HLINE, 0, 0, sl);
                  ObjectSetInteger(0, sl_name, OBJPROP_COLOR, clrRed);
                  ObjectSetInteger(0, sl_name, OBJPROP_STYLE, STYLE_DASH);
                  ObjectSetInteger(0, sl_name, OBJPROP_WIDTH, 1);
                  ObjectSetString(0, sl_name, OBJPROP_TOOLTIP, "Stop Loss: " + DoubleToString(sl, _Digits));
                 }
               else
                 {
                  double obj_price = ObjectGetDouble(0, sl_name, OBJPROP_PRICE);
                  if(MathAbs(obj_price - sl) > 0.00001)
                     ObjectSetDouble(0, sl_name, OBJPROP_PRICE, sl);
                 }
              }

            // Draw or update TP Line
            if(tp > 0)
              {
               string tp_name = "TP_" + ticket_str;
               if(ObjectFind(0, tp_name) < 0)
                 {
                  ObjectCreate(0, tp_name, OBJ_HLINE, 0, 0, tp);
                  ObjectSetInteger(0, tp_name, OBJPROP_COLOR, clrLime);
                  ObjectSetInteger(0, tp_name, OBJPROP_STYLE, STYLE_DASH);
                  ObjectSetInteger(0, tp_name, OBJPROP_WIDTH, 1);
                  ObjectSetString(0, tp_name, OBJPROP_TOOLTIP, "Take Profit: " + DoubleToString(tp, _Digits));
                 }
               else
                 {
                  double obj_price = ObjectGetDouble(0, tp_name, OBJPROP_PRICE);
                  if(MathAbs(obj_price - tp) > 0.00001)
                     ObjectSetDouble(0, tp_name, OBJPROP_PRICE, tp);
                 }
              }

            // Draw Entry Line (if not exists)
            string entry_name = "Entry_" + ticket_str;
            if(ObjectFind(0, entry_name) < 0)
              {
               ObjectCreate(0, entry_name, OBJ_HLINE, 0, 0, entry);
               ObjectSetInteger(0, entry_name, OBJPROP_COLOR, clrBlue);
               ObjectSetInteger(0, entry_name, OBJPROP_STYLE, STYLE_DOT);
               ObjectSetInteger(0, entry_name, OBJPROP_WIDTH, 1);
               ObjectSetString(0, entry_name, OBJPROP_TOOLTIP, "Entry: " + DoubleToString(entry, _Digits));
              }

            // Draw Entry Arrow (if not exists)
            string arrow_name = "Arrow_" + ticket_str;
            if(ObjectFind(0, arrow_name) < 0)
              {
               datetime open_time = (datetime)PositionGetInteger(POSITION_TIME);
               int arrow_code = (type == "BUY") ? 233 : 234;
               color arrow_color = (type == "BUY") ? clrLime : clrRed;
               if(ObjectCreate(0, arrow_name, OBJ_ARROW, 0, open_time, entry))
                 {
                  ObjectSetInteger(0, arrow_name, OBJPROP_ARROWCODE, arrow_code);
                  ObjectSetInteger(0, arrow_name, OBJPROP_COLOR, arrow_color);
                  ObjectSetInteger(0, arrow_name, OBJPROP_WIDTH, 2);
                  ObjectSetString(0, arrow_name, OBJPROP_TOOLTIP, type + " Entry at " + DoubleToString(entry, _Digits));
                 }
              }
           }
        }
      
      ChartRedraw(0);
     }
  };
