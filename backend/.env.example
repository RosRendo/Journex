DATABASE_URL="postgresql://username:password@localhost:5432/trading_journal?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/trading_journal?schema=public"

# Main Gateway Port
PORT=5000
NODE_ENV=production

# Backend URL (for Vercel frontend)
BACKEND_URL=https://api.yourdomain.com

# Frontend URL (for redirects and CORS)
FRONTEND_URL=https://app.yourdomain.com

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ─── Polar Payment Gateway ─────────────────────────────────────────────────────
# Get these from https://dashboard.polar.sh
POLAR_API_KEY=your_polar_api_key_here
POLAR_PRICE_STARTER=your_price_starter_id_here
POLAR_PRICE_PRO=your_price_pro_id_here
POLAR_PRICE_LIFETIME=your_price_lifetime_id_here
POLAR_WEBHOOK_SECRET=your_polar_webhook_secret_here

# ─── MT5 Bridge / Local Service URL ───────────────────────────────────────────
LOCAL_MT5_URL=http://127.0.0.1:5003
API_SECRET_KEY=generate_a_long_random_jwt_secret_here
